<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>SpawnDev WebTorrent server application. Combines tracker, web seed, and HuggingFace proxy. Doubles as test server for the Blazor WASM unit tests.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.WebTorrent.Server\SpawnDev.WebTorrent.Server.csproj" />
		<ProjectReference Include="..\SpawnDev.WebTorrent.Server.HuggingFace\SpawnDev.WebTorrent.Server.HuggingFace.csproj" />
		<!-- PackageReference (not ProjectReference) so this project builds from a
		     standalone SpawnDev.WebTorrent checkout without the sibling RTC repo. -->
		<PackageReference Include="SpawnDev.RTC.Server" Version="1.0.3" />
	</ItemGroup>

</Project>
