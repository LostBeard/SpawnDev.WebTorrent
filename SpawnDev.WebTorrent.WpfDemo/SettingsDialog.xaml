<Window x:Class="SpawnDev.WebTorrent.WpfDemo.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - SpawnDev.WebTorrent"
        Width="520" Height="620"
        Background="{StaticResource BgPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <!-- Transfer -->
        <TextBlock Text="Transfer" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,12" Padding="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Download Limit (KB/s)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBox x:Name="DownLimitBox" Grid.Column="1" Background="#111827" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}" Padding="6,3" FontFamily="Consolas"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Upload Limit (KB/s)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBox x:Name="UpLimitBox" Grid.Column="1" Background="#111827" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}" Padding="6,3" FontFamily="Consolas"/>
                </Grid>
                <TextBlock Text="0 = unlimited" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="200,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Connections -->
        <TextBlock Text="Connections" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,12" Padding="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Max Connections" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBox x:Name="MaxConnsBox" Grid.Column="1" Background="#111827" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}" Padding="6,3" FontFamily="Consolas"/>
                </Grid>
                <CheckBox x:Name="EnableTrackersCheck" Content="Enable Trackers" Foreground="{StaticResource TextSecondary}" Margin="0,6"/>
                <CheckBox x:Name="EnableDhtCheck" Content="Enable DHT (BEP 5)" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                <CheckBox x:Name="EnablePexCheck" Content="Enable Peer Exchange (BEP 11)" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                <CheckBox x:Name="EnableLsdCheck" Content="Enable Local Service Discovery (BEP 14)" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
                <CheckBox x:Name="EnableWebSeedsCheck" Content="Enable Web Seeds (BEP 19)" Foreground="{StaticResource TextSecondary}" Margin="0,4"/>
            </StackPanel>
        </Border>

        <!-- Default Trackers -->
        <TextBlock Text="Default Trackers (one per line)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,12" Padding="0,0,0,12">
            <TextBox x:Name="TrackersBox" Background="#111827" Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource Border}" Padding="6,4" FontFamily="Consolas" FontSize="11"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Storage -->
        <TextBlock Text="Storage" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,12" Padding="0,0,0,12">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Data Path" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StoragePathText" Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas"
                           FontSize="10" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Client Info -->
        <TextBlock Text="Client" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Peer ID" Foreground="{StaticResource TextMuted}"/>
            <TextBlock x:Name="PeerIdText" Grid.Column="1" Foreground="{StaticResource AccentGreen}" FontFamily="Consolas" FontSize="10"/>
        </Grid>
        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Version" Foreground="{StaticResource TextMuted}"/>
            <TextBlock Text="3.0.0-rc.2" Grid.Column="1" Foreground="{StaticResource TextSecondary}"/>
        </Grid>
        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Platform" Foreground="{StaticResource TextMuted}"/>
            <TextBlock Text="Desktop (.NET 10 / WPF / SipSorcery WebRTC)" Grid.Column="1" Foreground="{StaticResource TextSecondary}"/>
        </Grid>
        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="BEPs" Foreground="{StaticResource TextMuted}"/>
            <TextBlock Text="3, 5, 6, 9, 10, 11, 14, 15, 17, 19, 20, 23, 27, 44, 46, 48, 53" Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Apply" Margin="0,0,8,0" Padding="16,6"
                    Background="{StaticResource AccentGreen}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="Apply_Click"/>
            <Button Content="Close" Padding="16,6"
                    Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" Cursor="Hand"
                    Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
