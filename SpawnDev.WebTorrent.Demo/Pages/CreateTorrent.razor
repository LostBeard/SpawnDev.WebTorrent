@using SpawnDev.WebTorrent
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.JSObjects
@inject SpawnJSRuntime JS
@inject WebTorrentClient Client

@if (Visible)
{
<div class="modal-overlay" @onclick="Close" @onclick:stopPropagation>
<div class="modal-content" @onclick:stopPropagation style="max-width:800px;width:90vw;max-height:85vh;overflow-y:auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid #334155;">
        <h3 style="margin:0;color:#e2e8f0;">Create Torrent</h3>
        <button class="qb-btn-sm" @onclick="Close" style="font-size:1.2rem;">&#10005;</button>
    </div>

    <div style="display:flex;gap:16px;padding:16px;flex-wrap:wrap;">
        @* --- Left: File List --- *@
        <div style="flex:1;min-width:300px;">
            <div class="qb-panel">
                <div class="qb-panel-header">
                    <span>Files (@_files.Count)</span>
                    <span style="color:#94a3b8;font-size:0.85rem;">@FormatSize(_files.Sum(f => f.Size))</span>
                </div>

                @if (_files.Count == 0)
                {
                    <div style="padding:24px;text-align:center;color:#64748b;">
                        <p>No files added yet.</p>
                        <p style="font-size:0.85rem;">Add files or folders, or paste a URL.</p>
                    </div>
                }
                else
                {
                    <div style="max-height:300px;overflow-y:auto;">
                        <table class="qb-table" style="width:100%;">
                            <thead>
                                <tr>
                                    <th style="width:55%;">Name</th>
                                    <th style="width:20%;">Size</th>
                                    <th style="width:25%;">Path</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in _files)
                                {
                                    var f = file;
                                    <tr>
                                        <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:200px;" title="@f.Name">@f.Name</td>
                                        <td>@FormatSize(f.Size)</td>
                                        <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:150px;color:#94a3b8;font-size:0.85rem;" title="@f.Path">
                                            @f.Path
                                            <button class="qb-btn-sm" style="float:right;" @onclick="() => RemoveFile(f)" title="Remove">&#10005;</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div style="padding:8px;display:flex;gap:8px;flex-wrap:wrap;border-top:1px solid #334155;">
                    <button class="qb-btn" @onclick="AddFiles">Add Files</button>
                    @if (_showDirectoryPickerSupported)
                    {
                        <button class="qb-btn" @onclick="AddFolder">Add Folder</button>
                    }
                    <button class="qb-btn" @onclick="() => _showUrlInput = !_showUrlInput">Add from URL</button>
                    @if (_files.Count > 0)
                    {
                        <button class="qb-btn" style="margin-left:auto;color:#ef4444;" @onclick="ClearFiles">Clear All</button>
                    }
                </div>

                @if (_showUrlInput)
                {
                    <div style="padding:8px;border-top:1px solid #334155;display:flex;gap:8px;">
                        <input type="text" class="qb-input" style="flex:1;" placeholder="https://example.com/model.onnx"
                               @bind="_urlInput" @bind:event="oninput" @onkeydown="OnUrlKeyDown" />
                        <button class="qb-btn qb-btn-accent" @onclick="AddFromUrl"
                                disabled="@(string.IsNullOrWhiteSpace(_urlInput) || _downloading)">
                            @(_downloading ? "Downloading..." : "Add")
                        </button>
                    </div>
                }
            </div>
        </div>

        @* --- Right: Options --- *@
        <div style="flex:0 0 280px;min-width:240px;">
            <div class="qb-panel">
                <div class="qb-panel-header">Options</div>
                <div style="padding:12px;display:flex;flex-direction:column;gap:10px;">
                    <div>
                        <label class="qb-label">Torrent Name</label>
                        <input type="text" class="qb-input" placeholder="@(_files.Count > 0 ? _files[0].Name : "auto")"
                               @bind="_options.Name" />
                    </div>
                    <div>
                        <label class="qb-label">Comment</label>
                        <textarea class="qb-input" rows="2" @bind="_options.Comment"></textarea>
                    </div>
                    <div>
                        <label class="qb-label">Trackers (one per line)</label>
                        <textarea class="qb-input" rows="2" placeholder="wss://hub.spawndev.com:44365/announce"
                                  @bind="_trackers"></textarea>
                    </div>
                    <div>
                        <label class="qb-label">Web Seeds (one per line)</label>
                        <textarea class="qb-input" rows="2" @bind="_webSeeds"></textarea>
                    </div>
                    <div>
                        <label class="qb-label">Hash Algorithm</label>
                        <select class="qb-input" @bind="_options.HashAlgorithm">
                            <option value="SHA-256">SHA-256 (recommended)</option>
                            <option value="SHA-1">SHA-1 (legacy)</option>
                        </select>
                    </div>
                    <div style="display:flex;gap:16px;">
                        <label style="display:flex;align-items:center;gap:4px;color:#cbd5e1;cursor:pointer;">
                            <input type="checkbox" @bind="_private" /> Private
                        </label>
                        <label style="display:flex;align-items:center;gap:4px;color:#cbd5e1;cursor:pointer;">
                            <input type="checkbox" @bind="_startSeeding" /> Start Seeding
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- Footer --- *@
    <div style="padding:12px 16px;border-top:1px solid #334155;display:flex;gap:8px;justify-content:flex-end;align-items:center;">
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <span style="flex:1;font-size:0.85rem;color:@(_statusIsError ? "#fca5a5" : "#86efac");">@_statusMessage</span>
        }
        <button class="qb-btn" @onclick="Close">Cancel</button>
        <button class="qb-btn qb-btn-accent" style="padding:8px 24px;"
                @onclick="OnCreateTorrent" disabled="@(_files.Count == 0 || _creating)">
            @(_creating ? $"Creating... {_createProgress}" : "Create Torrent")
        </button>
    </div>
</div>
</div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<FileEntry> _files = new();
    private TorrentCreatorOptions _options = new()
    {
        HashAlgorithm = "SHA-256",
        CreatedBy = "SpawnDev.WebTorrent",
    };
    private string _trackers = "wss://hub.spawndev.com:44365/announce";
    private string _webSeeds = "";
    private bool _private;
    private bool _startSeeding = true;
    private string _urlInput = "";
    private bool _showUrlInput;
    private bool _downloading;
    private bool _creating;
    private string _createProgress = "";
    private string _statusMessage = "";
    private bool _statusIsError;
    private bool _showDirectoryPickerSupported;

    private class FileEntry
    {
        public string Name { get; set; } = "";
        public string Path { get; set; } = "";
        public long Size { get; set; }
        public byte[]? Data { get; set; }
    }

    protected override void OnInitialized()
    {
        using var window = JS.Get<Window>("window");
        _showDirectoryPickerSupported = window.ShowDirectoryPickerSupported();
    }

    private async Task Close()
    {
        _files.Clear();
        _statusMessage = "";
        _creating = false;
        await OnClose.InvokeAsync();
    }

    private async Task AddFiles()
    {
        try
        {
            using var window = JS.Get<Window>("window");
            using var handles = await window.ShowOpenFilePicker(new ShowOpenFilePickerOptions { Multiple = true });
            if (handles == null) return;
            for (int i = 0; i < handles.Length; i++)
            {
                using var handle = handles[i];
                using var file = await handle.GetFile();
                var data = await ReadFileToBytes(file);
                _files.Add(new FileEntry { Name = file.Name, Path = file.Name, Size = data.Length, Data = data });
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (!ex.Message.Contains("aborted"))
                SetStatus($"Error: {ex.Message}", true);
        }
    }

    private async Task AddFolder()
    {
        try
        {
            using var window = JS.Get<Window>("window");
            using var dirHandle = await window.ShowDirectoryPicker();
            if (dirHandle == null) return;
            await AddFilesFromDirectory(dirHandle, dirHandle.Name);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (!ex.Message.Contains("aborted"))
                SetStatus($"Error: {ex.Message}", true);
        }
    }

    private async Task AddFilesFromDirectory(FileSystemDirectoryHandle dir, string basePath)
    {
        await foreach (var entry in dir.ValuesEnumerable())
        {
            if (entry.Kind == "file")
            {
                using var fileHandle = entry.ToFileSystemFileHandle();
                using var file = await fileHandle.GetFile();
                var data = await ReadFileToBytes(file);
                _files.Add(new FileEntry { Name = file.Name, Path = $"{basePath}/{file.Name}", Size = data.Length, Data = data });
            }
            else if (entry.Kind == "directory")
            {
                using var subDir = entry.ToFileSystemDirectoryHandle();
                await AddFilesFromDirectory(subDir, $"{basePath}/{entry.Name}");
            }
            entry.Dispose();
        }
    }

    private async Task AddFromUrl()
    {
        if (string.IsNullOrWhiteSpace(_urlInput)) return;
        _downloading = true;
        _statusMessage = "";
        StateHasChanged();
        try
        {
            using var http = new HttpClient();
            using var response = await http.GetAsync(_urlInput, HttpCompletionOption.ResponseHeadersRead);
            response.EnsureSuccessStatusCode();
            var data = await response.Content.ReadAsByteArrayAsync();
            var uri = new Uri(_urlInput);
            var name = Uri.UnescapeDataString(uri.Segments.LastOrDefault()?.TrimEnd('/') ?? "download.bin");
            _files.Add(new FileEntry { Name = name, Path = name, Size = data.Length, Data = data });
            var basePath = string.Join("/", uri.Segments.Take(uri.Segments.Length - 1));
            var baseUrl = $"{uri.Scheme}://{uri.Authority}{basePath}".TrimEnd('/');
            if (!string.IsNullOrWhiteSpace(_webSeeds) && !_webSeeds.EndsWith("\n")) _webSeeds += "\n";
            if (!_webSeeds.Contains(baseUrl)) _webSeeds += baseUrl;
            SetStatus($"Downloaded {name} ({FormatSize(data.Length)})", false);
            _urlInput = "";
            _showUrlInput = false;
        }
        catch (Exception ex) { SetStatus($"Download failed: {ex.Message}", true); }
        finally { _downloading = false; StateHasChanged(); }
    }

    private async Task OnUrlKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await AddFromUrl(); }
    private void RemoveFile(FileEntry file) { _files.Remove(file); StateHasChanged(); }
    private void ClearFiles() { _files.Clear(); StateHasChanged(); }

    private async Task OnCreateTorrent()
    {
        if (_files.Count == 0) return;
        _creating = true;
        _createProgress = "preparing...";
        _statusMessage = "";
        StateHasChanged();
        try
        {
            var trackerList = _trackers.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(t => !string.IsNullOrWhiteSpace(t)).ToArray();
            var webSeedList = _webSeeds.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(w => !string.IsNullOrWhiteSpace(w)).ToArray();
            _options.Trackers = trackerList.Length > 0 ? trackerList : new[] { "wss://hub.spawndev.com:44365/announce" };
            _options.WebSeeds = webSeedList;
            _options.IsPrivate = _private;

            if (_files.Count == 1)
            {
                var file = _files[0];
                if (string.IsNullOrWhiteSpace(_options.Name)) _options.Name = file.Name;
                _createProgress = "hashing pieces...";
                StateHasChanged();
                var (torrentBytes, metadata) = TorrentCreator.CreateFromBytes(_options.Name, file.Data!, _options);
                if (_startSeeding)
                {
                    _createProgress = "seeding...";
                    StateHasChanged();
                    await Client.SeedAsync(_options.Name, file.Data!, _options);
                }
                SetStatus($"Created: {metadata.Name} ({FormatSize(metadata.TotalLength)}, {metadata.PieceCount} pieces, {_options.HashAlgorithm})", false);
            }
            else
            {
                var torrentName = string.IsNullOrWhiteSpace(_options.Name)
                    ? System.IO.Path.GetDirectoryName(_files[0].Path)?.Split('/', '\\').FirstOrDefault() ?? "torrent"
                    : _options.Name;
                var filesArray = _files.Select(f => (f.Path, f.Data!)).ToArray();
                _createProgress = "hashing pieces...";
                StateHasChanged();
                if (_startSeeding)
                {
                    _createProgress = "seeding...";
                    StateHasChanged();
                    var torrent = await Client.SeedAsync(torrentName, filesArray, _options);
                    SetStatus($"Created: {torrent.Name} ({FormatSize(torrent.Length)}, {torrent.PieceCount} pieces, {torrent.Files?.Length ?? 0} files)", false);
                }
                else
                {
                    var (torrentBytes, metadata) = TorrentCreator.CreateFromMultipleFiles(torrentName, filesArray, _options);
                    SetStatus($"Created: {metadata.Name} ({FormatSize(metadata.TotalLength)}, {metadata.PieceCount} pieces, {metadata.Files.Length} files)", false);
                }
            }
            _files.Clear();
            await Task.Delay(1500);
            await Close();
        }
        catch (Exception ex) { SetStatus($"Create failed: {ex.Message}", true); }
        finally { _creating = false; _createProgress = ""; StateHasChanged(); }
    }

    private void SetStatus(string msg, bool isError) { _statusMessage = msg; _statusIsError = isError; }

    private async Task<byte[]> ReadFileToBytes(File file)
    {
        using var arrayBuffer = await file.ArrayBuffer();
        using var uint8 = new Uint8Array(arrayBuffer);
        return uint8.ReadBytes();
    }

    private static string FormatSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes; int order = 0;
        while (len >= 1024 && order < sizes.Length - 1) { order++; len /= 1024; }
        return $"{len:0.##} {sizes[order]}";
    }
}

<style>
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(2px);
    }
    .modal-content {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
</style>
