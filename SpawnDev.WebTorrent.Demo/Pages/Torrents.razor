        _ => Client.Torrents.Where(t => !t.Destroyed).ToList(),
    };

    // ========================
    // LIFECYCLE
    // ========================
    protected override void OnInitialized()
    {
        // Derive peer ID display string
        try
        {
            var peerIdBytes = Convert.FromHexString(Client.PeerId);
            _peerIdStr = System.Text.Encoding.ASCII.GetString(peerIdBytes[..Math.Min(8, peerIdBytes.Length)]);
        }
        catch
        {
            _peerIdStr = Client.PeerId[..Math.Min(16, Client.PeerId.Length)];
        }

        // Initialize settings state
        var dlRate = Client.DownloadRateLimiter.Rate;
        var ulRate = Client.UploadRateLimiter.Rate;
        _settingsDlLimit = dlRate <= 0 ? 0 : dlRate / 1024;
        _settingsUlLimit = ulRate <= 0 ? 0 : ulRate / 1024;
        _settingsTrackers = string.Join("\n", Client.DefaultTrackers);

        // Wire up existing torrents
        foreach (var t in Client.Torrents)
            WireTorrentEvents(t);

        // Listen for new/removed torrents
        Client.OnAdd += OnTorrentAdded;
        Client.OnRemove += OnTorrentRemoved;

        // 1-second UI refresh timer
        _refreshTimer = new Timer(async _ =>
        {
            _globalDownSpeed = Client.Torrents.Sum(t => t.DownloadSpeed);
            _globalUpSpeed = Client.Torrents.Sum(t => t.UploadSpeed);
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    public async ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        Client.OnAdd -= OnTorrentAdded;
        Client.OnRemove -= OnTorrentRemoved;
    }

    // ========================
    // TORRENT EVENT WIRING
    // ========================
    private void WireTorrentEvents(Torrent torrent)
    {
        torrent.OnWire += (wire, id) =>
        {
            AddLog($"Peer connected: {id}", "qb-log-peer");
            _ = InvokeAsync(StateHasChanged);
        };

        torrent.OnMetadata += () =>
        {
            AddLog($"Metadata received: {torrent.Name} ({torrent.PieceCount} pieces, {FormatSize(torrent.Length)})", "qb-log-tracker");
            _ = InvokeAsync(StateHasChanged);
        };

        torrent.OnPieceVerified += (index) =>
        {
            AddLog($"Piece {index} verified ({torrent.CompletedPieces}/{torrent.PieceCount})", "qb-log-piece");
            _ = InvokeAsync(StateHasChanged);
        };

        torrent.OnDone += () =>
        {
            AddLog($"Download complete: {torrent.Name}", "qb-log-done");
            ShowToast($"Download complete: {torrent.Name}");
            _ = InvokeAsync(StateHasChanged);
        };

        torrent.OnWarning += (msg) =>
        {
            AddLog($"Warning: {msg}", "qb-log-err");
        };
    }

    private void OnTorrentAdded(Torrent torrent)
    {
        WireTorrentEvents(torrent);
        AddLog($"Torrent added: {torrent.Name ?? torrent.InfoHash ?? "unknown"}", "");
        _ = InvokeAsync(StateHasChanged);
