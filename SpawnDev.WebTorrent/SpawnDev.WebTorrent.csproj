<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Deploy wwwroot contents to the app's root, not _content/SpawnDev.WebTorrent/ -->
		<!-- Required for service worker scope — SW must be at app root to intercept all requests -->
		<StaticWebAssetBasePath Condition="$(StaticWebAssetBasePath) == ''">/</StaticWebAssetBasePath>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Version>4.2.9</Version>
		<PackageReleaseNotes>v4.2.8 - Rebuilt against SpawnDev.SpawnJS 2.1.17. 4.2.7 was compiled against SpawnJS 2.1.7, where FileSystemWritableFileStream.Seek and .Truncate took a ulong; 2.1.17 takes a long. The change is source-compatible, so every build of every consumer stayed green while the shipped IL still called the ulong overloads - the failure only appears at runtime, as MissingMethodException, and only on the code path that runs. Both call sites are on the real piece-write path (AsyncFSFileStore.WriteViewViaWritableAsync and GetWritableAsync), not only the OPFS layout probes, so any download taking the writable path threw. No API or behaviour change in this package: a recompile against the current SpawnJS is the entire fix. The two broken references were found by resolving every SpawnJS memberref in the shipped assembly against the assembly that actually loads, which is now a build gate (_tools/AbiCheck) rather than something a consumer discovers.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Title>SpawnDev.WebTorrent</Title>
		<Authors>LostBeard</Authors>
		<Description>Pure C# BitTorrent/WebTorrent client. 18 BEPs including BEP 52 v2 (SHA-256 + Merkle + hybrid + pure-v2 end-to-end), real WebRTC P2P (browser + desktop via SpawnDev.RTC), DHT with mutable items (BEP 46 — AI agent communication), web seeds, media streaming with seeking via service worker, OPFS storage. Includes webtorrent-sw.js for COI headers + torrent streaming. No JavaScript dependencies. Runs on desktop (.NET + SIPSorcery) and browser (Blazor WASM + SpawnDev.SpawnJS). 468+ shared test methods running on both browser and desktop runtimes + libtorrent 2.0 external-interop fixtures.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.WebTorrent</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.WebTorrent.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>BitTorrent;WebTorrent;P2P;Torrent;Blazor;WebAssembly;WebRTC;DHT;Streaming;MachineLearning;ModelDelivery;SIPSorcery</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SpawnDev.WebTorrent.Tests" />
		<InternalsVisibleTo Include="SpawnDev.WebTorrent.Demo.Shared" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" />
		<PackageReference Include="SpawnDev.AsyncFileSystem" />
		<PackageReference Include="SpawnDev.SpawnJS.Cryptography" />
		<!-- SpawnDev.RTC replaces direct SipSorcery dependency - provides cross-platform WebRTC
		     with proven browser-interop SipSorcery fork (SRTP profile fix) bundled inside.
		     PackageReference (not ProjectReference) so CI / GitHub Pages builds work from a
		     standalone SpawnDev.WebTorrent checkout - they don't have the sibling RTC repo.
		     1.1.1 is the minimum version: 1.1.0 declared a dep on public SIPSorcery 10.0.4-pre
		     which doesn't exist on nuget.org; 1.1.1 bundles the fork DLLs inline (ILGPU pattern). -->
		<PackageReference Include="SpawnDev.RTC" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

</Project>
