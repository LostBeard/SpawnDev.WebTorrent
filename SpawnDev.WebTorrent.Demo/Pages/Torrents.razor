@page "/torrents"
@using SpawnDev.WebTorrent
@using SpawnDev.WebTorrent.Torrent
@using SpawnDev.WebTorrent.Transports
@using SpawnDev.WebTorrent.Discovery
@using SpawnDev.WebTorrent.Storage
@using SpawnDev.WebTorrent.Wire
@using SpawnDev.AsyncFileSystem
@using Microsoft.AspNetCore.Components.Forms
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@inject BlazorJSRuntime JS
@inject IAsyncFS AsyncFS
@inject WebTorrentClient Client
@implements IAsyncDisposable

<PageTitle>SpawnDev.WebTorrent Client</PageTitle>

<div class="qb" tabindex="0" @onkeydown="OnKeyDown"
     @ondragover="OnDragOver" @ondragover:preventDefault
     @ondrop="OnDrop" @ondrop:preventDefault>
    @* ═══ Toolbar ═══ *@
    <div class="qb-toolbar">
        <div class="qb-toolbar-group">
            <div class="qb-add-row">
                <input type="text" class="qb-input" placeholder="magnet URI, info hash, or URL to .torrent file"
                       @bind="_magnetInput" @bind:event="oninput" @onkeydown="OnMagnetKeyDown" />
                <button class="qb-btn qb-btn-accent" @onclick="AddMagnet" disabled="@(string.IsNullOrWhiteSpace(_magnetInput))">Add</button>
            </div>
            <div class="qb-chip-row">
                @foreach (var (name, _) in CCMagnets)
                {
                    var n = name;
                    <button class="qb-chip" @onclick="() => QuickAdd(n)">@n</button>
                }
                <button class="qb-chip" style="border-color:#3b82f6;color:#3b82f6" @onclick="SeedTestData" title="Create and seed a test torrent">Seed Test</button>
                <label class="qb-chip" style="border-color:#8b5cf6;color:#8b5cf6;cursor:pointer" title="Seed a file from your computer">
                    Seed File
                    <InputFile OnChange="SeedFromFile" style="display:none" />
                </label>
                <label class="qb-chip" style="border-color:#f59e0b;color:#f59e0b;cursor:pointer" title="Open a .torrent file">
                    Open .torrent
                    <InputFile OnChange="OpenTorrentFile" accept=".torrent" style="display:none" />
                </label>
                <button class="qb-chip" style="border-color:#10b981;color:#10b981" @onclick="() => _showCreateTorrent = true" title="Create a new torrent">Create Torrent</button>
            </div>
        </div>
        <div class="qb-toolbar-actions">
            <button class="qb-btn qb-btn-sm" @onclick="PauseAll" title="Pause All">&#9646;&#9646;</button>
            <button class="qb-btn qb-btn-sm" @onclick="ResumeAll" title="Resume All">&#9654;</button>
            <button class="qb-btn qb-btn-sm" @onclick="ToggleSettings" title="Settings">&#9881;</button>
        </div>
        <div class="qb-speed-bar">
            @if (_globalDownHistory.Count > 1)
            {
                <svg class="qb-mini-spark" viewBox="0 0 60 16" preserveAspectRatio="none">
                    @{var dMax = Math.Max(_globalDownHistory.Max(), 1024.0); var dPts = string.Join(" ", _globalDownHistory.Select((v, i) => $"{i * 60.0 / Math.Max(_globalDownHistory.Count - 1, 1):F0},{(16 - v / dMax * 14):F0}"));}
                    <polyline points="@dPts" fill="none" stroke="#10b981" stroke-width="1.5"/>
                </svg>
            }
            <span class="qb-speed-down">&#x25BC; @FormatSpeed(_globalDownSpeed)</span>
            <span class="qb-speed-up">&#x25B2; @FormatSpeed(_globalUpSpeed)</span>
        </div>
    </div>

    @* ═══ Main Area ═══ *@
    <div class="qb-body">
        @* ── Sidebar (categories) ── *@
        <div class="qb-sidebar">
            <div class="qb-sidebar-item @(_filterStatus == "" ? "active" : "")" @onclick='() => _filterStatus = ""'>
                <span>All</span><span class="qb-count">@AllTorrents.Count</span>
            </div>
            <div class="qb-sidebar-item @(_filterStatus == "downloading" ? "active" : "")" @onclick='() => _filterStatus = "downloading"'>
                <span>Downloading</span><span class="qb-count">@AllTorrents.Count(t => !t.Done && t.HasMetadata)</span>
            </div>
            <div class="qb-sidebar-item @(_filterStatus == "seeding" ? "active" : "")" @onclick='() => _filterStatus = "seeding"'>
                <span>Seeding</span><span class="qb-count">@AllTorrents.Count(t => t.Done)</span>
            </div>
            <div class="qb-sidebar-item @(_filterStatus == "paused" ? "active" : "")" @onclick='() => _filterStatus = "paused"'>
                <span>Paused</span><span class="qb-count">@AllTorrents.Count(t => t.Paused)</span>
            </div>
        </div>

        @* ── Content ── *@
        <div class="qb-content">
            @* ── Torrent List ── *@
            <div class="qb-list">
                @if (FilteredTorrents.Count == 0)
                {
                    <div class="qb-empty">
                        <svg width="48" height="48" fill="#1e293b" viewBox="0 0 16 16" style="margin-bottom:12px"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                        <p style="font-size:14px;color:#475569">No torrents yet</p>
                        <p style="font-size:12px;color:#334155;margin-top:4px">Paste a magnet URI above, open a .torrent file, or try a quick-add</p>
                    </div>
                }
                else
                {
                    <table class="qb-table">
                        <thead>
                            <tr>
                                <th class="qb-col-status" title="Status"></th>
                                <th class="qb-col-name">Name</th>
                                <th class="qb-col-size">Size</th>
                                <th class="qb-col-progress">Progress</th>
                                <th class="qb-col-speed">DL Speed</th>
                                <th class="qb-col-speed">UL Speed</th>
                                <th class="qb-col-eta">ETA</th>
                                <th class="qb-col-peers">Peers</th>
                                <th class="qb-col-ratio">Ratio</th>
                                <th class="qb-col-actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in FilteredTorrents)
                            {
                                var entry = e;
                                var progress = entry.Progress;
                                var isSelected = _selectedTorrent == entry;
                                <tr class="@(isSelected ? "selected" : "") @(entry.Paused ? "paused" : "")"
                                    @onclick="() => SelectTorrent(entry)"
                                    @oncontextmenu="(e) => ShowContextMenu(entry, e)" @oncontextmenu:preventDefault>
                                    <td class="qb-col-status">
                                        <span class="qb-status-dot @StatusCss(entry)"></span>
                                    </td>
                                    <td class="qb-col-name">@entry.Name</td>
                                    <td class="qb-col-size">@SizeText(entry)</td>
                                    <td class="qb-col-progress">
                                        <div class="qb-progress">
                                            <div class="qb-progress-fill @(entry.Done ? "done" : "")" style="width:@((progress*100).ToString("F1"))%"></div>
                                            <span class="qb-progress-label">@((progress*100).ToString("F1"))%</span>
                                        </div>
                                    </td>
                                    <td class="qb-col-speed qb-mono">@(entry.DownloadSpeed > 10 ? FormatSpeed(entry.DownloadSpeed) : "")</td>
                                    <td class="qb-col-speed qb-mono">@(entry.UploadSpeed > 10 ? FormatSpeed(entry.UploadSpeed) : "")</td>
                                    <td class="qb-col-eta qb-mono">@EtaText(entry)</td>
                                    <td class="qb-col-peers">@entry.PeerCount</td>
                                    <td class="qb-col-ratio qb-mono">@entry.Ratio.ToString("F2")</td>
                                    <td class="qb-col-actions">
                                        @if (entry.Paused)
                                        {
                                            <button class="qb-icon-btn" @onclick="() => entry.Resume()" @onclick:stopPropagation title="Resume">&#9654;</button>
                                        }
                                        else
                                        {
                                            <button class="qb-icon-btn" @onclick="() => entry.Pause()" @onclick:stopPropagation title="Pause">&#9646;&#9646;</button>
                                        }
                                        <button class="qb-icon-btn qb-icon-delete" @onclick="() => ShowRemoveConfirm(entry)" @onclick:stopPropagation title="Remove">&#10005;</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @* ── Detail Panel ── *@
            @if (_selectedTorrent != null)
            {
                var sel = _selectedTorrent;
                <div class="qb-detail">
                    <div class="qb-tabs">
                        @foreach (var tab in new[] { "general", "trackers", "peers", "content", "log" })
                        {
                            var t = tab;
                            <button class="qb-tab @(_detailTab == t ? "active" : "")" @onclick="() => _detailTab = t">@char.ToUpper(t[0])@t[1..]</button>
                        }
                    </div>
                    <div class="qb-tab-body">
                        @switch (_detailTab)
                        {
                            case "general":
                                <div class="qb-info-grid">
                                    <div class="qb-info-row"><span class="qb-label">Name</span><span>@sel.Name</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Hash</span><span class="qb-mono qb-hash">@sel.InfoHashHex</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Size</span><span>@SizeText(sel)</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Pieces</span><span>@(sel.PieceManager != null ? $"{sel.PieceManager.CompletedCount} / {sel.PieceManager.PieceCount}" : "—")</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Downloaded</span><span>@FormatBytes(sel.Downloaded)</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Uploaded</span><span>@FormatBytes(sel.Uploaded)</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Ratio</span><span>@sel.Ratio.ToString("F3")</span></div>
                                    <div class="qb-info-row"><span class="qb-label">ETA</span><span>@EtaText(sel)</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Peers</span><span>@sel.PeerCount</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Comment</span><span>@(sel.Comment ?? "—")</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Created</span><span>@(sel.Created?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Private</span><span>@(sel.IsPrivate ? "Yes" : "No")</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Piece Length</span><span>@(sel.PieceLength > 0 ? FormatBytes(sel.PieceLength) : "—")</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Total Size</span><span>@(sel.Length > 0 ? FormatBytes(sel.Length) : "—")</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Web Seeds</span><span>@sel.WebSeedCount</span></div>
                                    <div class="qb-info-row"><span class="qb-label">Files</span><span>@sel.Files.Length</span></div>
                                </div>
                                @if (GetSpeedHistory(sel).Count > 1)
                                {
                                    <div class="qb-sparkline-label">Transfer Speed</div>
                                    <svg class="qb-sparkline" viewBox="0 0 200 40" preserveAspectRatio="none">
                                        @{
                                            var hist = GetSpeedHistory(sel);
                                            var maxSpeed = Math.Max(hist.Max(), 1024.0);
                                            var points = string.Join(" ", hist.Select((v, i) =>
                                                $"{i * 200.0 / Math.Max(hist.Count - 1, 1):F1},{(40 - v / maxSpeed * 38):F1}"));
                                        }
                                        <polyline points="@points" fill="none" stroke="#10b981" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
                                    </svg>
                                }
                                @if (sel.HasMetadata)
                                {
                                    <div class="qb-magnet-row">
                                        <span class="qb-label">Magnet</span>
                                        <input type="text" class="qb-input qb-magnet-display" readonly value="@sel.MagnetURI" @onclick="(e) => CopyMagnet(sel)" title="Click to copy" />
                                    </div>
                                }
                                <div class="qb-action-row">
                                    <button class="qb-action-btn" @onclick="() => CopyMagnet(sel)" title="Copy magnet link">&#128279; Copy Magnet</button>
                                    @if (sel.TorrentFileBytes != null)
                                    {
                                        <button class="qb-action-btn" @onclick="() => ExportTorrent(sel)" title="Download .torrent file">&#128190; Export .torrent</button>
                                    }
                                    <label class="qb-toggle">
                                        <input type="checkbox" checked="@false" @onchange="(e) => ToggleSequential(sel, (bool)(e.Value ?? false))" />
                                        <span>Sequential Download</span>
                                    </label>
                                </div>
                                @if (sel.PieceManager?.Bitfield != null)
                                {
                                    <div class="qb-piece-label">Pieces</div>
                                    <div class="qb-piece-bar">
                                        @{ var bf = sel.PieceManager.Bitfield; var total = bf.Length; var cols = Math.Min(total, 200); var step = Math.Max(1, total / cols); }
                                        @for (int i = 0; i < cols; i++)
                                        {
                                            var s = i * step; var end = Math.Min((i + 1) * step, total);
                                            bool any = false; for (int j = s; j < end; j++) if (bf[j]) { any = true; break; }
                                            <div class="qb-piece @(any ? "qb-piece-have" : "")"></div>
                                        }
                                    </div>
                                }
                                break;

                            case "trackers":
                                <table class="qb-sub-table">
                                    <thead><tr><th>Tracker</th><th>Type</th><th>Status</th></tr></thead>
                                    <tbody>
                                        @foreach (var tr in GetTrackers(sel))
                                        {
                                            var ttype = tr.Url.StartsWith("wss://") ? "WSS" : tr.Url.StartsWith("ws://") ? "WS" : tr.Url.StartsWith("http") ? "HTTP" : "UDP";
                                            <tr>
                                                <td class="qb-mono" style="font-size:11px">@tr.Url</td>
                                                <td><span class="qb-ext">@ttype</span></td>
                                                <td>
                                                    @if (tr.Status == "Connected") { <span style="color:#10b981">@tr.Status</span> }
                                                    else if (tr.Status == "Failed") { <span style="color:#ef4444">@tr.Status</span> }
                                                    else if (tr.Status.Contains("S /")) { <span style="color:#10b981">@tr.Status</span> }
                                                    else { <span style="color:#64748b">@tr.Status</span> }
                                                </td>
                                            </tr>
                                        }
                                        @if (GetTrackers(sel).Count == 0) { <tr><td colspan="3" class="qb-muted">No trackers connected</td></tr> }
                                    </tbody>
                                </table>
                                @if (sel.HasMetadata && sel.Metadata!.AnnounceList.Length > 0)
                                {
                                    <div style="margin-top:8px;color:#334155;font-size:10px">
                                        Announce list from .torrent: @string.Join(", ", sel.Announce.Take(5))
                                        @if (sel.Announce.Length > 5) { <span>... (+@(sel.Announce.Length - 5) more)</span> }
                                    </div>
                                }
                                break;

                            case "peers":
                                <div style="padding:0.5rem">
                                    <div style="margin-bottom:0.5rem;color:#64748b;font-size:12px">@(sel.PeerCount + (_peerCoordinators.GetValueOrDefault(sel.InfoHashHex)?.PeerCount ?? 0)) connected peer(s) — Web seeds: @sel.WebSeedCount</div>
                                    @if (sel.PeerCount + (_peerCoordinators.GetValueOrDefault(sel.InfoHashHex)?.PeerCount ?? 0) == 0)
                                    {
                                        <div class="qb-muted">Peers connect via WebSocket tracker signaling and WebRTC data channels.<br/>Desktop peers use SIPSorcery, browser peers use SpawnDev.BlazorJS.</div>
                                    }
                                </div>
                                break;

                            case "content":
                                @if (sel.HasMetadata)
                                {
                                    <div style="display:flex;gap:4px;padding:2px 0">
                                        <button class="qb-action-btn" style="font-size:10px" @onclick="() => { foreach (var f in sel.Files) f.Select(); }">Select All</button>
                                        <button class="qb-action-btn" style="font-size:10px" @onclick="() => { foreach (var f in sel.Files) f.Deselect(); }">Deselect All</button>
                                    </div>
                                    <table class="qb-sub-table">
                                        <thead><tr><th>File</th><th class="qb-col-fsize">Size</th><th class="qb-col-fprog-wide">Progress</th><th class="qb-col-fdl">Downloaded</th><th class="qb-col-ftype">Type</th><th class="qb-col-fpri">Priority</th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var file in sel.Files)
                                            {
                                                var f = file;
                                                var ext = System.IO.Path.GetExtension(f.Path).ToLowerInvariant();
                                                <tr class="@(f.Done ? "qb-file-done" : "")">
                                                    <td>@f.Path</td>
                                                    <td class="qb-col-fsize">@FormatBytes(f.Length)</td>
                                                    <td class="qb-col-fprog-wide">
                                                        <div class="qb-file-progress">
                                                            <div class="qb-file-progress-fill @(f.Done ? "done" : "")" style="width:@((f.Progress * 100).ToString("F1"))%"></div>
                                                            <span class="qb-file-progress-label">@((f.Progress * 100).ToString("F1"))%</span>
                                                        </div>
                                                    </td>
                                                    <td class="qb-col-fdl qb-mono">@FormatBytes(f.Downloaded)</td>
                                                    <td class="qb-col-ftype"><span class="qb-ext">@ext</span></td>
                                                    <td class="qb-col-fpri">
                                                        @{var ff = f;}
                                                        <select class="qb-pri-select" @onchange="(e) => SetFilePriority(ff, e.Value?.ToString())">
                                                            <option value="normal" selected>Normal</option>
                                                            <option value="high">High</option>
                                                            <option value="skip">Skip</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        @if (IsPlayable(ext))
                                                        {
                                                            <button class="qb-play-btn" @onclick="() => OpenMedia(f, ext)">&#9654;</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else { <div class="qb-muted" style="padding:1rem">Waiting for metadata...</div> }
                                break;

                            case "log":
                                <div style="display:flex;justify-content:flex-end;padding:2px 0">
                                    <button class="qb-action-btn" style="font-size:10px" @onclick="() => _logMessages.Clear()">Clear</button>
                                </div>
                                <div class="qb-log">
                                    @foreach (var msg in _logMessages.TakeLast(100))
                                    {
                                        var cls = msg.Contains("Error") || msg.Contains("error") || msg.Contains("Failed") ? "qb-log-err"
                                            : msg.Contains("Tracker") || msg.Contains("seeders") ? "qb-log-tracker"
                                            : msg.Contains("P2P") || msg.Contains("Peer") || msg.Contains("peer") ? "qb-log-peer"
                                            : msg.Contains("Piece") || msg.Contains("verified") || msg.Contains("complete") ? "qb-log-piece"
                                            : msg.Contains("Seeding") || msg.Contains("Download complete") ? "qb-log-done"
                                            : "";
                                        <div class="qb-log-line @cls">@msg</div>
                                    }
                                </div>
                                break;
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ═══ Status Bar ═══ *@
    <div class="qb-statusbar">
        <span>@AllTorrents.Count torrents</span>
        <span>@AllTorrents.Sum(t => t.PeerCount) peers</span>
        <span class="qb-speed-down">&#x25BC; @FormatSpeed(_globalDownSpeed)</span>
        <span class="qb-speed-up">&#x25B2; @FormatSpeed(_globalUpSpeed)</span>
        <span>@FormatBytes(AllTorrents.Sum(t => t.Downloaded)) downloaded</span>
        <span>@FormatBytes(AllTorrents.Sum(t => t.Uploaded)) uploaded</span>
        <span class="qb-mono">@PeerIdString</span>
        <span>v1.1.0</span>
        <span>@(_asyncFs != null ? "OPFS" : "MEM")</span>
    </div>

    @* ═══ Toast Notification ═══ *@
    @if (_toastVisible)
    {
        <div class="qb-toast @(_toastFading ? "qb-toast-fade" : "")">
            <span>@_toastMessage</span>
            <button class="qb-icon-btn" style="color:#f1f5f9" @onclick="() => _toastVisible = false">&#10005;</button>
        </div>
    }

    @* ═══ Context Menu ═══ *@
    @if (_contextMenuOpen)
    {
        <div class="qb-ctx-backdrop" @onclick="() => _contextMenuOpen = false"></div>
        <div class="qb-ctx-menu" style="left:@(_ctxX)px;top:@(_ctxY)px">
            @if (_contextEntry != null)
            {
                var ce = _contextEntry;
                @if (ce.Paused)
                {
                    <div class="qb-ctx-item" @onclick="() => { ce.Resume(); _contextMenuOpen = false; }">&#9654; Resume</div>
                }
                else
                {
                    <div class="qb-ctx-item" @onclick="() => { ce.Pause(); _contextMenuOpen = false; }">&#9646;&#9646; Pause</div>
                }
                <div class="qb-ctx-item" @onclick="() => { CopyMagnet(ce); _contextMenuOpen = false; }">&#128279; Copy Magnet URI</div>
                @if (ce.TorrentFileBytes != null)
                {
                    <div class="qb-ctx-item" @onclick="() => { ExportTorrent(ce); _contextMenuOpen = false; }">&#128190; Export .torrent</div>
                }
                <div class="qb-ctx-item" @onclick="() => ShowProperties(ce)">&#9432; Properties</div>
                <div class="qb-ctx-sep"></div>
                <div class="qb-ctx-item qb-ctx-danger" @onclick="() => { ShowRemoveConfirm(ce); _contextMenuOpen = false; }">&#10005; Remove</div>
            }
        </div>
    }

    @* ═══ Remove Confirmation Dialog ═══ *@
    @if (_removeConfirmOpen && _removeConfirmTarget != null)
    {
        <div class="qb-overlay" @onclick="() => _removeConfirmOpen = false">
            <div class="qb-modal" style="max-width:420px;" @onclick:stopPropagation>
                <div class="qb-modal-header">
                    <span>Remove Torrent</span>
                    <button class="qb-icon-btn" @onclick="() => _removeConfirmOpen = false">&#10005;</button>
                </div>
                <div style="padding:16px;color:#cbd5e1;">
                    <p style="margin-bottom:12px;">Remove <strong>@_removeConfirmTarget.Name</strong>?</p>
                    <p style="font-size:0.85rem;color:#94a3b8;margin-bottom:16px;">
                        Downloaded data is stored in browser storage (OPFS) and cannot be accessed outside this app.
                    </p>
                    <div style="display:flex;gap:8px;justify-content:flex-end;">
                        <button class="qb-btn" @onclick="() => _removeConfirmOpen = false">Cancel</button>
                        <button class="qb-btn" style="color:#fca5a5;" @onclick="() => ConfirmRemove(false)">Remove (keep data)</button>
                        <button class="qb-btn qb-btn-accent" style="background:#dc2626;" @onclick="() => ConfirmRemove(true)">Remove + Delete Data</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ═══ Media Modal ═══ *@
    @if (_mediaOpen)
    {
        <div class="qb-overlay" @onclick="CloseMedia">
            <div class="qb-modal qb-modal-media" @onclick:stopPropagation>
                <div class="qb-modal-header">
                    <span>@_mediaFileName</span>
                    <button class="qb-icon-btn" @onclick="CloseMedia">&#10005;</button>
                </div>
                <div class="qb-modal-body">
                    @if (_mediaLoading) { <div class="qb-muted" style="padding:3rem;text-align:center">Downloading...</div> }
                    else if (_mediaType == "video") { <video src="@_mediaBlobUrl" controls autoplay class="qb-media-video"></video> }
                    else if (_mediaType == "audio") { <audio src="@_mediaBlobUrl" controls autoplay style="width:100%"></audio> }
                    else if (_mediaType == "image") { <img src="@_mediaBlobUrl" class="qb-media-img" /> }
                </div>
            </div>
        </div>
    }

    @* ═══ Settings Modal ═══ *@
    @if (_settingsOpen)
    {
        <div class="qb-overlay" @onclick="() => _settingsOpen = false">
            <div class="qb-modal qb-modal-settings" @onclick:stopPropagation>
                <div class="qb-modal-header"><span>Settings</span><button class="qb-icon-btn" @onclick="() => _settingsOpen = false">&#10005;</button></div>
                <div class="qb-modal-body">
                    <h4>Transfer</h4>
                    <div class="qb-setting"><label>Download Limit (KB/s)</label><input type="number" class="qb-input qb-input-sm" value="@_downloadLimitKBs" @onchange="e => SetDownloadLimit(e)" placeholder="0 = unlimited" /></div>
                    <div class="qb-setting"><label>Upload Limit (KB/s)</label><input type="number" class="qb-input qb-input-sm" value="@_uploadLimitKBs" @onchange="e => SetUploadLimit(e)" placeholder="0 = unlimited" /></div>
                    <h4>Default Trackers</h4>
                    @foreach (var t in _defaultTrackers) { <div class="qb-mono" style="font-size:0.7rem;color:#475569">@t</div> }
                    <h4>Client</h4>
                    <div class="qb-setting"><label>Peer ID</label><span class="qb-mono" style="color:#10b981">@PeerIdString</span></div>
                    <div class="qb-setting"><label>Version</label><span>2.0.0</span></div>
                    <div class="qb-setting"><label>Platform</label><span>@(OperatingSystem.IsBrowser() ? "Browser (Blazor WASM)" : "Desktop")</span></div>
                    <div class="qb-setting"><label>Storage</label><span>@(_asyncFs != null ? "OPFS (persistent)" : "Memory")</span></div>
                    <div class="qb-setting"><label>WebRTC</label><span>SpawnDev.BlazorJS</span></div>
                    <div class="qb-setting"><label>BEPs</label><span>3, 5, 6, 9, 10, 11, 15, 17, 19, 20, 23, 27, 44, 46, 53</span></div>
                    <div class="qb-setting"><label>Tests</label><span>444 (428 pass, 16 skip)</span></div>
                </div>
            </div>
        </div>
    }
</div>

<CreateTorrent Visible="_showCreateTorrent" OnClose="() => _showCreateTorrent = false" />

@code {
    // ── State ──
    private string _magnetInput = "";
    private bool _showCreateTorrent;
    private readonly List<string> _logMessages = new();
    private WebTorrentClient? _client;
    private IAsyncFS? _asyncFs => AsyncFS;
    private System.Threading.Timer? _refreshTimer;
    private TorrentSwarm? _selectedTorrent;
    private string _detailTab = "general";
    private string _filterStatus = "";
    private bool _settingsOpen;
    private int _downloadLimitKBs, _uploadLimitKBs;
    private double _globalDownSpeed, _globalUpSpeed;

    // Toast
    private bool _toastVisible;
    private bool _toastFading;
    private string _toastMessage = "";

    // Global speed history
    private readonly List<double> _globalDownHistory = new();
    private readonly List<double> _globalUpHistory = new();

    // Context menu
    private bool _contextMenuOpen;
    private TorrentSwarm? _contextEntry;
    private double _ctxX, _ctxY;

    // UI-only state per torrent (keyed by InfoHashHex)
    private readonly Dictionary<string, List<double>> _speedHistory = new();
    private readonly Dictionary<string, List<TrackerEntry>> _trackerEntries = new();
    private readonly Dictionary<string, PeerCoordinator?> _peerCoordinators = new();
    private readonly Dictionary<string, IWebRtcTransport?> _webRtcTransports = new();
    private List<double> GetSpeedHistory(TorrentSwarm t) { if (!_speedHistory.ContainsKey(t.InfoHashHex)) _speedHistory[t.InfoHashHex] = new(); return _speedHistory[t.InfoHashHex]; }
    private List<TrackerEntry> GetTrackers(TorrentSwarm t) { if (!_trackerEntries.ContainsKey(t.InfoHashHex)) _trackerEntries[t.InfoHashHex] = new(); return _trackerEntries[t.InfoHashHex]; }

    // Media
    private bool _mediaOpen, _mediaLoading;
    private string _mediaType = "", _mediaFileName = "", _mediaBlobUrl = "";

    private static readonly string[] _defaultTrackers = { "wss://hub.spawndev.com:44365/announce", "wss://tracker.openwebtorrent.com", "wss://tracker.files.fm:7073/announce" };

    private static readonly Dictionary<string, string> CCMagnets = new()
    {
        ["Big Buck Bunny"] = "magnet:?xt=urn:btih:dd8255ecdc7ca55fb0bbf81323d87062db1f6d1c&dn=Big+Buck+Bunny&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fbig-buck-bunny.torrent",
        ["Sintel"] = "magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10&dn=Sintel&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fsintel.torrent",
        ["Cosmos Laundromat"] = "magnet:?xt=urn:btih:c9e15763f722f23e98a29decdfae341b98d53056&dn=Cosmos+Laundromat&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fcosmos-laundromat.torrent",
        ["Tears of Steel"] = "magnet:?xt=urn:btih:209c8226b299b308beaf2b9cd3fb49212dbd13ec&dn=Tears+of+Steel&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Ftears-of-steel.torrent",
    };

    private string PeerIdString => _client != null ? System.Text.Encoding.ASCII.GetString(_client.PeerId, 0, 8) : "-SD0110-";
    private IReadOnlyList<TorrentSwarm> AllTorrents => Client.Torrents;
    private List<TorrentSwarm> FilteredTorrents => _filterStatus switch
    {
        "downloading" => AllTorrents.Where(t => !t.Done && t.HasMetadata).ToList(),
        "seeding" => AllTorrents.Where(t => t.Done).ToList(),
        "paused" => AllTorrents.Where(t => t.Paused).ToList(),
        _ => AllTorrents.ToList(),
    };

    protected override void OnInitialized()
    {
        _client = Client;
        Log($"Client initialized ({AllTorrents.Count} torrent(s), storage: {(_asyncFs != null ? "OPFS" : "memory")})");

        _refreshTimer = new System.Threading.Timer(_ =>
        {
            foreach (var t in AllTorrents)
            {
                t.UpdateSpeed();
                GetSpeedHistory(t).Add(t.DownloadSpeed);
                if (GetSpeedHistory(t).Count > 60) GetSpeedHistory(t).RemoveAt(0); // 60 second window

                // Auto-wire torrents added externally (e.g., via CreateTorrent dialog)
                if (!_trackerEntries.ContainsKey(t.InfoHashHex) && t.HasMetadata)
                {
                    WireSwarmEvents(t);
                    // Populate tracker display entries from metadata (library already handles signaling)
                    var entries = GetTrackers(t);
                    foreach (var url in t.Announce)
                        entries.Add(new TrackerEntry { Url = url, Status = "Connected (library)" });
                }
            }
            _globalDownSpeed = AllTorrents.Sum(t => t.DownloadSpeed);
            _globalUpSpeed = AllTorrents.Sum(t => t.UploadSpeed);
            _globalDownHistory.Add(_globalDownSpeed);
            _globalUpHistory.Add(_globalUpSpeed);
            if (_globalDownHistory.Count > 30) _globalDownHistory.RemoveAt(0);
            if (_globalUpHistory.Count > 30) _globalUpHistory.RemoveAt(0);
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    // ── Actions ──
    private async Task OnMagnetKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_magnetInput)) await AddMagnet(); }
    private async Task QuickAdd(string name) { if (CCMagnets.TryGetValue(name, out var m)) { var h = m.Split("btih:")[1].Split("&")[0]; if (!AllTorrents.Any(t => t.InfoHashHex == h)) await AddMagnetInternal(m, name); } }
    private async Task AddMagnet() { var i = _magnetInput.Trim(); _magnetInput = ""; if (!string.IsNullOrWhiteSpace(i)) await AddMagnetInternal(i, null); }
    private async Task SeedTestData()
    {
        if (_client == null) return;
        var data = new byte[65536]; // 64KB test data
        Random.Shared.NextBytes(data);
        var name = $"SpawnDev-Test-{DateTime.Now:HHmmss}.bin";

        var swarm = await _client.SeedAsync(data, name,
            new TorrentCreatorOptions
            {
                PieceLength = 16384,
                Trackers = _defaultTrackers,
                Comment = "Test torrent created by SpawnDev.WebTorrent demo",
            });

        _selectedTorrent = swarm;
        WireSwarmEvents(swarm);
        _ = ConnectTrackers(swarm, swarm.MagnetURI);

        Log($"Seeding: {name} ({FormatBytes(data.Length)}), magnet: {swarm.MagnetURI[..60]}...");
        StateHasChanged();
    }

    private async Task SeedFromFile(InputFileChangeEventArgs e)
    {
        if (_client == null) return;
        var file = e.File;
        if (file == null) return;

        Log($"Loading file: {file.Name} ({FormatBytes(file.Size)})...");
        using var ms = new System.IO.MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 1073741824).CopyToAsync(ms); // 1GB max
        var data = ms.ToArray();

        var swarm = await _client.SeedAsync(data, file.Name,
            new TorrentCreatorOptions
            {
                PieceLength = data.Length > 1048576 ? 262144 : 16384, // 256KB pieces for >1MB files
                Trackers = _defaultTrackers,
                Comment = $"Seeded from SpawnDev.WebTorrent demo",
            });

        _selectedTorrent = swarm;
        WireSwarmEvents(swarm);
        _ = ConnectTrackers(swarm, swarm.MagnetURI);

        Log($"Seeding: {file.Name} ({FormatBytes(data.Length)}), {swarm.PieceManager!.PieceCount} pieces");
        StateHasChanged();
    }

    private async Task OpenTorrentFile(InputFileChangeEventArgs e)
    {
        if (_client == null) return;
        var file = e.File;
        if (file == null) return;

        using var ms = new System.IO.MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10485760).CopyToAsync(ms); // 10MB max for .torrent
        var torrentBytes = ms.ToArray();

        try
        {
            var metadata = TorrentParser.Parse(torrentBytes);
            var hash = Convert.ToHexString(metadata.InfoHash).ToLowerInvariant();
            if (AllTorrents.Any(t => t.InfoHashHex == hash)) { Log($"Already added: {metadata.Name}"); return; }

            var swarm = await _client.AddAsync(metadata, new AddTorrentOptions { AsyncFileSystem = _asyncFs });
            _selectedTorrent = swarm;

            foreach (var ws in metadata.UrlList) swarm.AddWebSeed(ws.TrimEnd('/'));
            WireSwarmEvents(swarm);
            swarm.StartDownload();
            _ = ConnectTrackers(swarm, swarm.MagnetURI);

            Log($"Opened: {metadata.Name} ({FormatBytes(metadata.TotalLength)}, {metadata.PieceCount} pieces)");
            StateHasChanged();
        }
        catch (Exception ex) { Log($"Invalid .torrent: {ex.Message}"); }
    }

    private void PauseAll() { foreach (var t in AllTorrents) t.Pause(); }
    private void ResumeAll() { foreach (var t in AllTorrents) t.Resume(); }
    private void ToggleSettings() => _settingsOpen = !_settingsOpen;
    private void SelectTorrent(TorrentSwarm e) { _selectedTorrent = e; _detailTab = "general"; }
    private void SetDownloadLimit(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) { _downloadLimitKBs = v; if (_client != null) _client.DownloadLimit = v <= 0 ? -1 : v * 1024; } }
    private void SetUploadLimit(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) { _uploadLimitKBs = v; if (_client != null) _client.UploadLimit = v <= 0 ? -1 : v * 1024; } }

    private async Task AddMagnetInternal(string magnetUri, string? displayName)
    {
        if (_client == null) return;
        try
        {
            var swarm = await _client.AddAsync(magnetUri, new AddTorrentOptions { AsyncFileSystem = _asyncFs });
            _selectedTorrent ??= swarm;
            Log($"Added: {swarm.Name}");
            _ = ConnectTrackers(swarm, magnetUri);
            _ = FetchMetadataAndDownload(swarm, magnetUri);
            StateHasChanged();
        }
        catch (Exception ex) { Log($"Error: {ex.Message}"); }
    }

    private async Task FetchMetadataAndDownload(TorrentSwarm entry, string magnetUri)
    {
        if (entry.HasMetadata)
        {

            foreach (var ws in entry.Metadata!.UrlList) entry.AddWebSeed(ws.TrimEnd('/'));
            WireSwarmEvents(entry);
            entry.StartDownload();
            Log($"[{entry.Name}] {FormatBytes(entry.Metadata!.TotalLength)}, {entry.Metadata.PieceCount} pieces");
            await InvokeAsync(StateHasChanged); return;
        }

        string? torrentUrl = null; var webSeedUrls = new List<string>();
        foreach (var part in magnetUri.Split('&'))
        {
            var p = part.Contains('?') ? part.Split('?').Last() : part;
            var eq = p.IndexOf('='); if (eq < 0) continue;
            var k = p[..eq]; var v = Uri.UnescapeDataString(p[(eq + 1)..].Replace('+', ' '));
            if (k == "xs") torrentUrl = v; if (k == "ws") webSeedUrls.Add(v);
        }
        if (torrentUrl == null) { Log($"[{entry.Name}] No xs= URL"); return; }

        try
        {
            Log($"[{entry.Name}] Fetching .torrent...");
            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(15) };
            var torrentBytes = await http.GetByteArrayAsync(torrentUrl);
            var metadata = TorrentParser.Parse(torrentBytes);
            if (!metadata.InfoHash.SequenceEqual(entry.InfoHash)) return;
            foreach (var ws in metadata.UrlList) if (!webSeedUrls.Contains(ws)) webSeedUrls.Add(ws);
            await entry.SetMetadataAsync(metadata);            foreach (var ws in webSeedUrls) entry.AddWebSeed(ws.TrimEnd('/'));
            WireSwarmEvents(entry);
            entry.StartDownload();
            Log($"[{entry.Name}] {FormatBytes(metadata.TotalLength)}, {metadata.PieceCount} pieces, {webSeedUrls.Count} web seed(s)");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Log($"[{entry.Name}] {ex.Message}"); }
    }

    private void WireSwarmEvents(TorrentSwarm entry)
    {
        entry.OnPieceVerified += (_) => InvokeAsync(StateHasChanged);
        entry.OnDone += () => { Log($"[{entry.Name}] Download complete!"); ShowToast($"Download complete: {entry.Name}"); InvokeAsync(StateHasChanged); };
        entry.OnError += (ex) => Log($"[{entry.Name}] Error: {ex.Message}");
        entry.OnLog += (msg) => Log($"[{entry.Name}] {msg}");
    }

    private async Task ConnectTrackers(TorrentSwarm entry, string magnetUri)
    {
        var wsTrackers = new List<string>();
        var httpTrackers = new List<string>();
        foreach (var part in magnetUri.Split('&'))
        {
            var p = part.Contains('?') ? part.Split('?').Last() : part;
            if (p.StartsWith("tr="))
            {
                var url = Uri.UnescapeDataString(p[3..].Replace('+', ' '));
                if (url.StartsWith("wss://") || url.StartsWith("ws://")) wsTrackers.Add(url);
                else if (url.StartsWith("http://") || url.StartsWith("https://")) httpTrackers.Add(url);
            }
        }
        if (wsTrackers.Count == 0) wsTrackers.AddRange(_defaultTrackers);

        // WebSocket trackers via PeerCoordinator (for WebRTC signaling)
        var webRtc = IWebRtcTransport.Create(); _webRtcTransports[entry.InfoHashHex] = webRtc;
        var coordinator = new PeerCoordinator(_client!, entry.InfoHash, webRtc); _peerCoordinators[entry.InfoHashHex] = coordinator;
        coordinator.OnPeerConnected += (peer) => { Log($"[{entry.Name}] P2P: {peer.PeerId[..Math.Min(12, peer.PeerId.Length)]}"); _ = entry.AddConnectedPeerAsync(peer.Wire, new PeerInfo { Address = peer.PeerId, Source = "webrtc" }); InvokeAsync(StateHasChanged); };
        coordinator.OnPeerDisconnected += (_) => InvokeAsync(StateHasChanged);
        foreach (var url in wsTrackers) { _ = ConnectSingleTracker(entry, coordinator, url); }

        // HTTP trackers (peer discovery only — no WebRTC signaling)
        foreach (var url in httpTrackers) { _ = ConnectHttpTracker(entry, url); }
    }

    private async Task ConnectHttpTracker(TorrentSwarm entry, string url)
    {
        var te = new TrackerEntry { Url = url, Status = "Connecting..." }; GetTrackers(entry).Add(te);
        try
        {
            var tracker = new HttpTrackerClient(url, _client!.PeerId);
            tracker.OnAnnounceResponse += (s, l) => { te.Status = $"{s}S / {l}L"; InvokeAsync(StateHasChanged); };
            tracker.OnPeer += (peer) => entry.AddPeer(peer);
            await tracker.StartAsync(entry.InfoHash, 0);
            te.Status = "Connected";
        }
        catch { te.Status = "Failed"; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConnectSingleTracker(TorrentSwarm entry, PeerCoordinator coordinator, string url)
    {
        var te = new TrackerEntry { Url = url, Status = "Connecting..." }; GetTrackers(entry).Add(te);
        try { await coordinator.AddTrackerAsync(url); te.Status = "Connected"; Log($"[{entry.Name}] Tracker: {new Uri(url).Host}"); }
        catch { te.Status = "Failed"; }
        await InvokeAsync(StateHasChanged);
    }

    private bool _removeConfirmOpen;
    private TorrentSwarm? _removeConfirmTarget;

    private void ShowRemoveConfirm(TorrentSwarm entry)
    {
        _removeConfirmTarget = entry;
        _removeConfirmOpen = true;
        StateHasChanged();
    }

    private async Task ConfirmRemove(bool destroyData)
    {
        if (_removeConfirmTarget != null)
            await RemoveTorrent(_removeConfirmTarget, destroyData);
        _removeConfirmOpen = false;
        _removeConfirmTarget = null;
    }

    private async Task RemoveTorrent(TorrentSwarm entry, bool destroyData = false)
    {
        if (_selectedTorrent == entry) _selectedTorrent = null;
        var hash = entry.InfoHashHex;
        if (_peerCoordinators.TryGetValue(hash, out var pc) && pc != null) await pc.DisposeAsync();
        if (_webRtcTransports.TryGetValue(hash, out var wrt) && wrt != null) await wrt.DisposeAsync();
        _peerCoordinators.Remove(hash);
        _webRtcTransports.Remove(hash);
        _speedHistory.Remove(hash);
        _trackerEntries.Remove(hash);
        if (_client != null) await _client.RemoveAsync(entry, destroyData);
        Log(destroyData ? $"Removed + deleted data: {entry.Name}" : $"Removed: {entry.Name}");
    }

    private void OnDragOver(DragEventArgs e) { }

    private async Task OnDrop(DragEventArgs e)
    {
        // Try to get dropped text (magnet URI or URL)
        try
        {
            var text = await JS.CallAsync<string>("eval", "event.dataTransfer?.getData('text/plain') || ''");
            if (!string.IsNullOrWhiteSpace(text))
            {
                text = text.Trim();
                if (text.StartsWith("magnet:", StringComparison.OrdinalIgnoreCase) ||
                    text.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                    text.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                {
                    await AddMagnetInternal(text, null);
                    Log($"Added via drag-drop: {text[..Math.Min(50, text.Length)]}...");
                }
            }
        }
        catch { }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_selectedTorrent == null) return;
        switch (e.Key)
        {
            case "Delete":
                ShowRemoveConfirm(_selectedTorrent);
                break;
            case " ": // Space
                if (_selectedTorrent.Paused) _selectedTorrent.Resume();
                else _selectedTorrent.Pause();
                break;
            case "c" when e.CtrlKey: // Ctrl+C
                await CopyMagnet(_selectedTorrent);
                break;
        }
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _toastVisible = true;
        _toastFading = false;
        _ = FadeToastAsync();
    }

    private async Task FadeToastAsync()
    {
        await Task.Delay(4000);
        _toastFading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(500);
        _toastVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ShowProperties(TorrentSwarm entry)
    {
        _detailTab = "general";
        SelectTorrent(entry);
        _contextMenuOpen = false;
    }

    private void ShowContextMenu(TorrentSwarm entry, MouseEventArgs e)
    {
        _contextEntry = entry;
        _ctxX = e.ClientX;
        _ctxY = e.ClientY;
        _contextMenuOpen = true;
        SelectTorrent(entry);
    }

    private void SetFilePriority(TorrentFileStream file, string? priority)
    {
        switch (priority)
        {
            case "high": file.Select(10); Log($"File priority: {file.Name} → High"); break;
            case "skip": file.Deselect(); Log($"File priority: {file.Name} → Skip"); break;
            default: file.Select(1); Log($"File priority: {file.Name} → Normal"); break;
        }
    }

    private void ToggleSequential(TorrentSwarm entry, bool sequential)
    {
        // Sequential mode — future implementation
        if (entry.Coordinator != null)
            entry.Coordinator.Strategy = sequential ? "sequential" : "rarest";
        Log($"[{entry.Name}] Strategy: {(sequential ? "sequential" : "rarest-first")}");
    }

    // ── Torrent Actions ──
    private async Task CopyMagnet(TorrentSwarm entry)
    {
        var magnet = entry.MagnetURI;
        try
        {
            await JS.CallVoidAsync("navigator.clipboard.writeText", magnet);
            Log($"Copied magnet URI to clipboard");
        }
        catch
        {
            Log($"Magnet: {magnet}");
        }
    }

    private async Task ExportTorrent(TorrentSwarm entry)
    {
        var bytes = entry.TorrentFileBytes;
        if (bytes == null) return;
        var fileName = $"{entry.Name}.torrent";
        using var blob = new Blob(new[] { bytes }, new BlobOptions { Type = "application/x-bittorrent" });
        var url = URL.CreateObjectURL(blob);
        // Trigger download via anchor click
        await JS.CallVoidAsync("eval", $"var a=document.createElement('a');a.href='{url}';a.download='{fileName.Replace("'", "\\'")}';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL('{url}')");
        Log($"Exported: {fileName}");
    }

    private async Task OpenMedia(TorrentFileStream file, string ext)
    {
        _mediaFileName = file.Name; _mediaType = IsVideoFile(ext) ? "video" : IsAudioFile(ext) ? "audio" : "image";
        _mediaOpen = true; _mediaLoading = false;

        // Use service worker streaming URL — supports range requests for seeking
        _mediaBlobUrl = file.StreamURL;

        StateHasChanged();
    }

    private void CloseMedia()
    {
        _mediaOpen = false; _mediaBlobUrl = "";
    }

    // ── Helpers ──
    private void Log(string msg) { _logMessages.Add($"[{DateTime.Now:HH:mm:ss}] {msg}"); }
    private static string FormatBytes(long b) => b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024.0:F1} KB" : b < 1073741824 ? $"{b / 1048576.0:F1} MB" : $"{b / 1073741824.0:F2} GB";
    private static string FormatSpeed(double bps) => bps < 1024 ? $"{bps:F0} B/s" : bps < 1048576 ? $"{bps / 1024.0:F1} KB/s" : $"{bps / 1048576.0:F1} MB/s";
    private static bool IsVideoFile(string ext) => ext is ".mp4" or ".webm" or ".mkv" or ".ogv" or ".mov";
    private static bool IsAudioFile(string ext) => ext is ".mp3" or ".ogg" or ".flac" or ".wav" or ".aac" or ".opus";
    private static bool IsImageFile(string ext) => ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
    private static bool IsPlayable(string ext) => IsVideoFile(ext) || IsAudioFile(ext) || IsImageFile(ext);
    private static string GetMimeType(string ext) => ext switch { ".mp4" => "video/mp4", ".webm" => "video/webm", ".mkv" => "video/x-matroska", ".mp3" => "audio/mpeg", ".ogg" => "audio/ogg", ".flac" => "audio/flac", ".wav" => "audio/wav", ".jpg" or ".jpeg" => "image/jpeg", ".png" => "image/png", ".gif" => "image/gif", ".webp" => "image/webp", _ => "application/octet-stream" };

    public async ValueTask DisposeAsync() { _refreshTimer?.Dispose(); CloseMedia(); }

    // ── TorrentSwarm UI helpers ──
    private static string StatusCss(TorrentSwarm t) => t.Done ? "qb-dot-seed" : t.Paused ? "qb-dot-paused" : t.HasMetadata ? "qb-dot-dl" : "qb-dot-meta";
    private static string SizeText(TorrentSwarm t) => t.HasMetadata ? FormatBytes(t.Metadata!.TotalLength) : "—";
    private static string EtaText(TorrentSwarm t) { var r = t.TimeRemaining; return r < 0 ? (t.Done ? "—" : "∞") : r < 60000 ? $"{r / 1000}s" : r < 3600000 ? $"{r / 60000}m" : $"{r / 3600000}h {(r % 3600000) / 60000}m"; }

    private class TrackerEntry { public string Url { get; set; } = ""; public string Status { get; set; } = ""; }

    /// <summary>
    /// Holds state for a single streaming session. Named method for proper += / -= cleanup.
    /// </summary>
    private class StreamState
    {
        public MessagePort Port { get; set; } = null!;
        public TorrentFileStream File { get; set; } = null!;
        public TorrentMetadata Metadata { get; set; } = null!;
        public AsyncFSChunkStore? OpfsStore { get; set; }
        public long Offset { get; set; }
        public int Remaining { get; set; }
        public Action<MessageEvent>? Handler { get; set; }
        private const int ChunkSize = 65536;

        public void HandlePull(MessageEvent pullMsg)
        {
            var pullData = pullMsg.GetData<bool>();
            if (!pullData)
            {
                Cleanup();
                return;
            }

            _ = Task.Run(async () =>
            {
                try
                {
                    if (Remaining <= 0)
                    {
                        Port.PostMessage(null);
                        Cleanup();
                        return;
                    }

                    var toRead = (int)Math.Min(ChunkSize, Remaining);
                    var pieceIdx = (int)(Offset / Metadata.PieceLength);
                    var pieceOffset = (int)(Offset % Metadata.PieceLength);

                    // Zero-copy path: read piece as Uint8Array directly from OPFS
                    if (OpfsStore != null && OpfsStore.SupportsUint8Array)
                    {
                        using var pieceUint8 = await OpfsStore.GetUint8ArrayAsync(pieceIdx);
                        if (pieceUint8 != null)
                        {
                            var available = (int)pieceUint8.Length - pieceOffset;
                            var sendLen = Math.Min(toRead, available);
                            using var slice = pieceUint8.Slice(pieceOffset, pieceOffset + sendLen);
                            Port.PostMessage(slice);
                            Offset += sendLen;
                            Remaining -= sendLen;
                            return;
                        }
                    }

                    // Fallback: read through .NET byte[]
                    var chunk = await File.ReadAsync(Offset, toRead);
                    Offset += chunk.Length;
                    Remaining -= chunk.Length;
                    using var uint8 = new Uint8Array(chunk);
                    Port.PostMessage(uint8);
                }
                catch
                {
                    Port.PostMessage(null);
                    Cleanup();
                }
            });
        }

        private void Cleanup()
        {
            if (Handler != null)
            {
                Port.OnMessage -= Handler;
                Handler = null;
            }
        }
    }
}

