<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- SpawnDev packages -->
    <PackageVersion Include="SpawnDev.RTC" Version="2.0.2" />
    <PackageVersion Include="SpawnDev.RTC.Server" Version="2.0.2" />
    <!-- SpawnJS: the library (SpawnDev.WebTorrent) is on SpawnJS; the BlazorJS entries below remain
         for the not-yet-converted ServerApp / PlaywrightMultiTest projects. -->
    <PackageVersion Include="SpawnDev.SpawnJS" Version="2.0.9" />
    <PackageVersion Include="SpawnDev.SpawnJS.Cryptography" Version="2.0.1" />
    <PackageVersion Include="SpawnDev.BlazorJS" Version="3.5.15" />
    <PackageVersion Include="SpawnDev.BlazorJS.Cryptography" Version="3.2.0" />
    <PackageVersion Include="SpawnDev.AsyncFileSystem" Version="2.0.0" />
    <PackageVersion Include="SpawnDev.BackgroundServices" Version="2.0.0" />
    <PackageVersion Include="SpawnDev.UnitTesting" Version="2.5.6" />
    <PackageVersion Include="SpawnDev.UnitTesting.Blazor" Version="2.5.6" />
    <PackageVersion Include="SpawnDev.UnitTesting.Desktop" Version="2.5.3" />
    <!-- Microsoft / ASP.NET -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="4.13.0" />
    <!-- Test tooling -->
    <PackageVersion Include="Microsoft.Playwright.NUnit" Version="1.52.0" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>