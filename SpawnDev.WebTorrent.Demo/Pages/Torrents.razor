@page "/torrents"
@using SpawnDev.WebTorrent
@using SpawnDev.WebTorrent.Torrent
@using SpawnDev.WebTorrent.Transports
@using SpawnDev.WebTorrent.Discovery
@using SpawnDev.WebTorrent.Storage
@implements IAsyncDisposable

<PageTitle>Torrents</PageTitle>

<h3>Torrent Client</h3>
<hr />

<div class="client-container">
    @* ── Add Torrent ── *@
    <div class="add-section">
        <div class="input-row">
            <input type="text" class="magnet-input" placeholder="Paste magnet URI or info hash..."
                   @bind="_magnetInput" @bind:event="oninput"
                   @onkeydown="OnMagnetKeyDown" />
            <button class="btn btn-primary" @onclick="AddMagnet" disabled="@(string.IsNullOrWhiteSpace(_magnetInput))">
                Add
            </button>
        </div>
        <div class="quick-add">
            <span class="quick-label">Quick add:</span>
            @foreach (var (name, magnet) in CCMagnets)
            {
                var n = name;
                var m = magnet;
                <button class="btn btn-sm btn-tag" @onclick="() => QuickAdd(n, m)">@n</button>
            }
        </div>
    </div>

    @* ── Client Stats Bar ── *@
    <div class="stats-bar">
        <span>Torrents: <strong>@_torrents.Count</strong></span>
        <span>Peers: <strong>@_torrents.Sum(t => t.Swarm.PeerCount)</strong></span>
        <span>Peer ID: <code>@PeerIdString</code></span>
    </div>

    @* ── Torrent List ── *@
    @if (_torrents.Count == 0)
    {
        <div class="empty-state">
            <p>No torrents. Add a magnet URI above or use a quick-add button.</p>
        </div>
    }
    else
    {
        <div class="torrent-list">
            @foreach (var entry in _torrents)
            {
                <div class="torrent-card @(entry.Expanded ? "expanded" : "")">
                    <div class="torrent-header" @onclick="() => entry.Expanded = !entry.Expanded">
                        <div class="torrent-name">
                            @(entry.Swarm.Metadata?.Name ?? entry.Name ?? "Loading metadata...")
                        </div>
                        <div class="torrent-meta">
                            @if (entry.Swarm.HasMetadata)
                            {
                                <span class="tag tag-size">@FormatBytes(entry.Swarm.Metadata!.TotalLength)</span>
                                <span class="tag tag-pieces">@entry.Swarm.Metadata!.PieceCount pcs</span>
                            }
                            <span class="tag tag-peers">@entry.Swarm.PeerCount peers</span>
                            <span class="tag tag-hash">@entry.InfoHashShort</span>
                        </div>
                    </div>

                    @if (entry.Swarm.HasMetadata)
                    {
                        var progress = entry.PieceManager?.Progress ?? entry.Swarm.Progress;
                        var isComplete = entry.PieceManager?.IsComplete ?? entry.Swarm.Done;
                        <div class="progress-bar-container">
                            <div class="progress-bar" style="width: @((progress * 100).ToString("F1"))%"></div>
                        </div>
                        <div class="progress-text">
                            @((progress * 100).ToString("F1"))%
                            — @(entry.PieceManager?.CompletedCount ?? 0)/@(entry.Swarm.Metadata!.PieceCount) pieces
                            @if (isComplete)
                            {
                                <span class="done-badge">Complete</span>
                            }
                        </div>
                    }

                    @if (entry.Expanded && entry.Swarm.HasMetadata)
                    {
                        <div class="torrent-details">
                            <table class="file-table">
                                <thead>
                                    <tr>
                                        <th>File</th>
                                        <th class="col-size">Size</th>
                                        <th class="col-progress">Progress</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in entry.Swarm.Files)
                                    {
                                        <tr>
                                            <td class="file-name">@file.Path</td>
                                            <td class="col-size">@FormatBytes(file.Length)</td>
                                            <td class="col-progress">@((file.Progress * 100).ToString("F0"))%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="detail-row">
                                <span>Info Hash: <code>@entry.InfoHashFull</code></span>
                            </div>
                            <div class="detail-row">
                                <span>Piece Length: @FormatBytes(entry.Swarm.Metadata!.PieceLength)</span>
                                <span>Downloaded: @FormatBytes(entry.Swarm.Downloaded)</span>
                                <span>Uploaded: @FormatBytes(entry.Swarm.Uploaded)</span>
                            </div>

                            @if (entry.TrackerStatus != null)
                            {
                                <div class="detail-row">
                                    <span>Tracker: @entry.TrackerStatus</span>
                                </div>
                            }

                            <div class="detail-actions">
                                <button class="btn btn-sm btn-danger" @onclick="() => RemoveTorrent(entry)">Remove</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Log ── *@
    @if (_logMessages.Count > 0)
    {
        <div class="log-section">
            <h4>Activity Log</h4>
            <div class="log-container">
                @foreach (var msg in _logMessages.TakeLast(50))
                {
                    <div class="log-line">@msg</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string _magnetInput = "";
    private readonly List<TorrentEntry> _torrents = new();
    private readonly List<string> _logMessages = new();
    private WebTorrentClient? _client;
    private System.Threading.Timer? _refreshTimer;

    private static readonly Dictionary<string, string> CCMagnets = new()
    {
        ["Big Buck Bunny"] = "magnet:?xt=urn:btih:dd8255ecdc7ca55fb0bbf81323d87062db1f6d1c&dn=Big+Buck+Bunny&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fbig-buck-bunny.torrent",
        ["Sintel"] = "magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10&dn=Sintel&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fsintel.torrent",
        ["Cosmos Laundromat"] = "magnet:?xt=urn:btih:c9e15763f722f23e98a29decdfae341b98d53056&dn=Cosmos+Laundromat&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fcosmos-laundromat.torrent",
        ["Tears of Steel"] = "magnet:?xt=urn:btih:209c8226b299b308beaf2b9cd3fb49212dbd13ec&dn=Tears+of+Steel&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Ftears-of-steel.torrent",
    };

    private string PeerIdString => _client != null
        ? System.Text.Encoding.ASCII.GetString(_client.PeerId, 0, 8)
        : "-SD0110-";

    protected override void OnInitialized()
    {
        _client = new WebTorrentClient();
        Log($"Client initialized. Peer ID: {PeerIdString}");

        // Refresh UI every 2 seconds for live stats
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, 2000, 2000);
    }

    private async Task OnMagnetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_magnetInput))
            await AddMagnet();
    }

    private async Task QuickAdd(string name, string magnet)
    {
        // Check if already added
        var hash = magnet.Split("btih:")[1].Split("&")[0].ToLowerInvariant();
        if (_torrents.Any(t => t.InfoHashFull == hash))
        {
            Log($"{name} already added");
            return;
        }

        Log($"Adding {name}...");
        await AddMagnetInternal(magnet, name);
    }

    private async Task AddMagnet()
    {
        var input = _magnetInput.Trim();
        _magnetInput = "";
        if (string.IsNullOrWhiteSpace(input)) return;
        Log($"Adding: {input[..Math.Min(60, input.Length)]}...");
        await AddMagnetInternal(input, null);
    }

    private async Task AddMagnetInternal(string magnetUri, string? displayName)
    {
        if (_client == null) return;

        try
        {
            var swarm = await _client.AddAsync(magnetUri);
            var entry = new TorrentEntry
            {
                Swarm = swarm,
                Name = displayName,
                InfoHashFull = Convert.ToHexString(swarm.InfoHash).ToLowerInvariant(),
                InfoHashShort = Convert.ToHexString(swarm.InfoHash).ToLowerInvariant()[..8] + "...",
            };

            _torrents.Add(entry);
            Log($"Added: {entry.Name ?? entry.InfoHashShort}");

            // Connect to trackers
            _ = ConnectTrackers(entry, magnetUri);

            // Try to fetch .torrent metadata from xs= URL
            _ = FetchMetadataAndStartDownload(entry, magnetUri);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Log($"Error: {ex.Message}");
        }
    }

    private async Task FetchMetadataAndStartDownload(TorrentEntry entry, string magnetUri)
    {
        // Extract xs= (exact source / .torrent URL) and ws= (web seeds) from magnet
        string? torrentUrl = null;
        var webSeedUrls = new List<string>();

        foreach (var part in magnetUri.Split('&'))
        {
            var p = part.Contains('?') ? part.Split('?').Last() : part;
            var eqIdx = p.IndexOf('=');
            if (eqIdx < 0) continue;
            var key = p[..eqIdx];
            var val = Uri.UnescapeDataString(p[(eqIdx + 1)..].Replace('+', ' '));

            if (key == "xs") torrentUrl = val;
            if (key == "ws") webSeedUrls.Add(val);
        }

        // Fetch .torrent file if xs= URL is available
        if (torrentUrl != null)
        {
            try
            {
                Log($"[{entry.Name ?? entry.InfoHashShort}] Fetching .torrent from {torrentUrl.Split('/').Last()}...");
                using var http = new HttpClient();
                http.Timeout = TimeSpan.FromSeconds(15);
                var torrentBytes = await http.GetByteArrayAsync(torrentUrl);
                var metadata = TorrentParser.Parse(torrentBytes);

                // Verify info hash matches
                if (!metadata.InfoHash.SequenceEqual(entry.Swarm.InfoHash))
                {
                    Log($"[{entry.Name ?? entry.InfoHashShort}] .torrent info hash mismatch — ignoring");
                    return;
                }

                // Add web seeds from .torrent metadata
                foreach (var ws in metadata.UrlList)
                    if (!webSeedUrls.Contains(ws)) webSeedUrls.Add(ws);

                // Set metadata on swarm (creates chunk store and file streams)
                entry.Swarm.SetMetadata(metadata);
                entry.Name ??= metadata.Name;
                Log($"[{entry.Name}] Metadata loaded: {metadata.Files.Length} file(s), {FormatBytes(metadata.TotalLength)}, {metadata.PieceCount} pieces");

                // Create download coordinator and start downloading via web seeds
                var store = new MemoryChunkStore(metadata.PieceLength);
                var pm = new PieceManager(metadata, store);
                var coordinator = new DownloadCoordinator(pm, metadata);
                entry.Coordinator = coordinator;
                entry.PieceManager = pm;

                // Add web seeds
                foreach (var wsUrl in webSeedUrls)
                {
                    coordinator.AddWebSeed(new HttpClient { Timeout = TimeSpan.FromSeconds(30) }, wsUrl);
                    Log($"[{entry.Name}] Web seed: {wsUrl}");
                }

                // Wire up progress events
                coordinator.OnPieceComplete += (idx) =>
                {
                    InvokeAsync(StateHasChanged);
                };
                coordinator.OnProgressChanged += (p) =>
                {
                    InvokeAsync(StateHasChanged);
                };
                coordinator.OnDownloadComplete += () =>
                {
                    Log($"[{entry.Name}] Download complete!");
                    InvokeAsync(StateHasChanged);
                };

                // Start downloading
                coordinator.Start();
                Log($"[{entry.Name}] Download started ({webSeedUrls.Count} web seed(s))");

                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Log($"[{entry.Name ?? entry.InfoHashShort}] Metadata fetch failed: {ex.Message}");
            }
        }
        else
        {
            Log($"[{entry.Name ?? entry.InfoHashShort}] No .torrent URL (xs=) — waiting for metadata from peers");
        }
    }

    private async Task ConnectTrackers(TorrentEntry entry, string magnetUri)
    {
        // Extract tracker URLs from magnet URI
        var trackers = new List<string>();
        if (magnetUri.Contains("&tr="))
        {
            foreach (var part in magnetUri.Split('&'))
            {
                if (part.StartsWith("tr=") || part.StartsWith("&tr="))
                {
                    var url = Uri.UnescapeDataString(part.Replace("tr=", "").Replace("&", ""));
                    if (url.StartsWith("wss://"))
                        trackers.Add(url);
                }
            }
        }

        // Add default trackers if none found
        if (trackers.Count == 0)
        {
            trackers.AddRange(new[]
            {
                "wss://hub.spawndev.com:44365/announce",
                "wss://tracker.openwebtorrent.com",
                "wss://tracker.files.fm:7073/announce",
            });
        }

        foreach (var trackerUrl in trackers)
        {
            try
            {
                var peerId = _client!.PeerId;
                var tracker = new WebSocketTrackerClient(trackerUrl, peerId);
                int seeders = 0, leechers = 0;

                tracker.OnAnnounceResponse += (s, l) =>
                {
                    seeders = s;
                    leechers = l;
                    entry.TrackerStatus = $"{trackerUrl.Split('/')[2]}: {s}S/{l}L";
                    Log($"[{entry.Name ?? entry.InfoHashShort}] Tracker: {s} seeders, {l} leechers");
                    InvokeAsync(StateHasChanged);
                };

                tracker.OnPeer += (peer) =>
                {
                    Log($"[{entry.Name ?? entry.InfoHashShort}] Peer: {peer.Address[..Math.Min(16, peer.Address.Length)]}...");
                };

                tracker.OnError += (err) =>
                {
                    Log($"[{entry.Name ?? entry.InfoHashShort}] Tracker error: {err}");
                };

                await tracker.StartAsync(entry.Swarm.InfoHash, 0);
                entry.Trackers.Add(tracker);
                Log($"[{entry.Name ?? entry.InfoHashShort}] Connected to {trackerUrl.Split('/')[2]}");
                break; // Connected to one tracker successfully
            }
            catch (Exception ex)
            {
                Log($"Tracker {trackerUrl.Split('/')[2]} failed: {ex.Message}");
            }
        }
    }

    private async Task RemoveTorrent(TorrentEntry entry)
    {
        foreach (var tracker in entry.Trackers)
            await tracker.DisposeAsync();
        entry.Trackers.Clear();

        if (_client != null)
            await _client.RemoveAsync(entry.Swarm);

        _torrents.Remove(entry);
        Log($"Removed: {entry.Name ?? entry.InfoHashShort}");
        StateHasChanged();
    }

    private void Log(string message)
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss");
        _logMessages.Add($"[{timestamp}] {message}");
        if (_logMessages.Count > 200)
            _logMessages.RemoveRange(0, _logMessages.Count - 200);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1048576) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1073741824) return $"{bytes / 1048576.0:F1} MB";
        return $"{bytes / 1073741824.0:F2} GB";
    }

    public async ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        foreach (var entry in _torrents)
        {
            foreach (var tracker in entry.Trackers)
                await tracker.DisposeAsync();
        }
        if (_client != null)
            await _client.DisposeAsync();
    }

    private class TorrentEntry
    {
        public TorrentSwarm Swarm { get; init; } = null!;
        public string? Name { get; set; }
        public string InfoHashFull { get; init; } = "";
        public string InfoHashShort { get; init; } = "";
        public string? TrackerStatus { get; set; }
        public bool Expanded { get; set; }
        public List<WebSocketTrackerClient> Trackers { get; } = new();
        public DownloadCoordinator? Coordinator { get; set; }
        public PieceManager? PieceManager { get; set; }
    }
}

