{
  // ═══════════════════════════════════════════════════════════════
  //  SpawnDev.WebTorrent.ServerApp — Configuration
  //
  //  Copy this file to appsettings.json and customize for your
  //  deployment. All values shown are defaults — only include
  //  settings you want to change.
  //
  //  Environment-specific overrides: appsettings.Production.json
  //  Environment variables: use __ as separator
  //    e.g., HuggingFace__MaxCacheSizeBytes=10737418240
  // ═══════════════════════════════════════════════════════════════

  // ─── WebSocket Tracker ─────────────────────────────────────────
  "Tracker": {
    // Seconds between client announce requests (lower = more responsive, more traffic)
    "AnnounceInterval": 120,

    // Maximum peers returned per announce response
    "MaxPeersPerAnnounce": 50
  },

  // ─── Web Seed Server ───────────────────────────────────────────
  "WebSeed": {
    // Directory for manually seeded torrent data
    // Relative to working directory, or absolute path
    "Directory": "seed-data"
  },

  // ─── HuggingFace Model Proxy & Cache ───────────────────────────
  "HuggingFace": {
    // Cache directories for downloaded model files.
    // Models are stored in the directory with the most free space.
    // Multiple paths allow spreading across drives.
    //
    // Examples:
    //   Linux:   ["/var/cache/spawndev-hub/hf", "/mnt/data/hf-cache"]
    //   Windows: ["D:\\cache\\hf", "E:\\cache\\hf"]
    //   Default: ["hf-cache"] (relative to working directory)
    "CacheDirectories": [ "hf-cache" ],

    // Tracker URLs included in generated .torrent files.
    // Clients use these to discover peers for P2P model sharing.
    // Replace with your own tracker URL if self-hosting.
    "TrackerUrls": [ "wss://hub.spawndev.com:44365/announce" ],

    // Maximum total cache size in bytes across all directories.
    // When exceeded, least-recently-requested models are evicted.
    // 0 = no explicit limit (drive free space protection still applies).
    //
    // Examples:
    //   10 GB:  10737418240
    //   50 GB:  53687091200
    //   100 GB: 107374182400
    "MaxCacheSizeBytes": 0,

    // Minimum free disk space to maintain on each cache drive (bytes).
    // Server evicts cached models before the drive drops below this.
    // This is a safety net — even without MaxCacheSizeBytes, the
    // server will never fill your drive.
    //
    // Default: 2 GB (2147483648)
    // For small VMs, consider 1 GB: 1073741824
    "MinFreeDiskSpaceBytes": 2147483648
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
