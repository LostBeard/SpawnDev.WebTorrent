<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Deploy wwwroot contents to the app's root, not _content/SpawnDev.WebTorrent/ -->
		<!-- Required for service worker scope — SW must be at app root to intercept all requests -->
		<StaticWebAssetBasePath Condition="$(StaticWebAssetBasePath) == ''">/</StaticWebAssetBasePath>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Version>3.2.8-local.4</Version>
		<PackageReleaseNotes>v3.2.8-local.4: OPFS read-cache fix (model-load crawl). AsyncFSChunkStore.GetAsync(index, offset, length) read the WHOLE piece file from OPFS then sliced out the requested range -- so a streaming parser reading a piece in many small chunks re-read each whole piece from OPFS 16-64x, making SD-Turbo model loads crawl. Now caches the last whole-piece read so consecutive chunk-reads of the same piece slice from memory (one OPFS read per piece); invalidated on write. v3.2.8-local.3: Concurrent leaf hashing for the zero-copy browser download. All 16 KiB SubtleCrypto leaf digests for a piece now run via one Task.WhenAll (native crypto overlaps) instead of being awaited one-by-one -- the prior sequential awaits were N interop round-trips per piece and cost more than the byte[] copy they replaced. v3.2.8-local.2: Zero-copy browser web-seed download. A single-file torrent on a browser OPFS store now keeps each piece's bytes in JS end to end: browser fetch (BlazorJSRuntime.Fetch) -> JS Uint8Array -> SubtleCrypto 16 KiB-leaf hashes -> .NET Merkle tree over only the 32-byte hashes (MerkleHasher.ComputePieceRootFromLeafHashes, byte-identical to ComputePieceLayer, verified) -> OPFS write. The piece data never enters the .NET/WASM heap; per-piece verification preserved. Desktop unaffected (byte[] path). v3.2.8: Web-seed download concurrency fix. Web seeds now pipeline a FIXED number of parallel range requests (MaxWebConns, default raised 4 to 8) instead of a speed-based piece pipeline that was chicken-and-egg for HTTP web seeds (started at ~1 in flight, so serial, so low measured speed, so it stayed at ~1). Model loads from the hub web seed crawled at one piece in flight far below LAN bandwidth; now saturate the link (measured ~118MB/s sustained on a 1GB LAN). v3.2.7: Thread-safety fix for Piece (the per-piece block-download state machine). Piece is a 1:1 port of JS torrent-piece (single-threaded event loop); the C# client drives downloads from multiple threads, so the download loop's Reserve()/ReserveRemaining() could race a concurrent wire-arrival callback's Set()/Flush() (which null the piece buffers) → NullReferenceException on large multi-piece torrents (hit loading a 2.5GB SD-Turbo model). All Piece state mutators are now serialized on a per-Piece re-entrant lock (no-op on single-threaded WASM, atomic on desktop). v3.2.6: Adds TorrentFileInfo.ReadUint8ArrayAsync zero-copy JS-typed random-access read for browser GPU upload.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Title>SpawnDev.WebTorrent</Title>
		<Authors>LostBeard</Authors>
		<Description>Pure C# BitTorrent/WebTorrent client. 18 BEPs including BEP 52 v2 (SHA-256 + Merkle + hybrid + pure-v2 end-to-end), real WebRTC P2P (browser + desktop via SpawnDev.RTC), DHT with mutable items (BEP 46 — AI agent communication), web seeds, media streaming with seeking via service worker, OPFS storage. Includes webtorrent-sw.js for COI headers + torrent streaming. No JavaScript dependencies. Runs on desktop (.NET + SIPSorcery) and browser (Blazor WASM + SpawnDev.BlazorJS). 468+ shared test methods running on both browser and desktop runtimes + libtorrent 2.0 external-interop fixtures.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.WebTorrent</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.WebTorrent.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>BitTorrent;WebTorrent;P2P;Torrent;Blazor;WebAssembly;WebRTC;DHT;Streaming;MachineLearning;ModelDelivery;SIPSorcery</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SpawnDev.WebTorrent.Tests" />
		<InternalsVisibleTo Include="SpawnDev.WebTorrent.Demo.Shared" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.BlazorJS" Version="3.5.6" />
		<PackageReference Include="SpawnDev.AsyncFileSystem" Version="1.2.0" />
		<PackageReference Include="SpawnDev.BlazorJS.Cryptography" Version="3.2.0" />
		<!-- SpawnDev.RTC replaces direct SipSorcery dependency - provides cross-platform WebRTC
		     with proven browser-interop SipSorcery fork (SRTP profile fix) bundled inside.
		     PackageReference (not ProjectReference) so CI / GitHub Pages builds work from a
		     standalone SpawnDev.WebTorrent checkout - they don't have the sibling RTC repo.
		     1.1.1 is the minimum version: 1.1.0 declared a dep on public SIPSorcery 10.0.4-pre
		     which doesn't exist on nuget.org; 1.1.1 bundles the fork DLLs inline (ILGPU pattern). -->
		<PackageReference Include="SpawnDev.RTC" Version="1.1.9-rc.1" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

</Project>
