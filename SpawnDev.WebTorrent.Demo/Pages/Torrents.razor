@page "/torrents"
@using SpawnDev.WebTorrent
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@using Microsoft.AspNetCore.Components.Forms
@inject BlazorJSRuntime JS
@inject WebTorrentClient Client
@implements IAsyncDisposable

<PageTitle>Torrents - SpawnDev.WebTorrent</PageTitle>

<div class="qb" @onkeydown="OnKeyDown" tabindex="0" @ondragover="OnDragOver" @ondragover:preventDefault @ondrop="OnDrop" @ondrop:preventDefault>
    @* ============ TOOLBAR ============ *@
    <div class="qb-toolbar">
        <div class="qb-toolbar-group">
            <div class="qb-add-row">
                <input class="qb-input" placeholder="magnet:?xt=urn:btih:..." @bind="_magnetInput" @bind:event="oninput"
                       @onkeydown="OnMagnetKeyDown" />
                <button class="qb-btn qb-btn-accent" @onclick="AddMagnet"
                        disabled="@(string.IsNullOrWhiteSpace(_magnetInput))">Add</button>
                <label class="qb-btn" style="margin:0;cursor:pointer;">
                    Open .torrent
                    <InputFile OnChange="OnTorrentFileSelected" style="display:none;" accept=".torrent" />
                </label>
                <button class="qb-btn" @onclick="() => _showCreateTorrent = true" title="Create Torrent">Create</button>
            </div>
            <div class="qb-chip-row">
                @foreach (var kv in QuickMagnets)
                {
                    var name = kv.Key;
                    var magnet = kv.Value;
                    <button class="qb-chip" @onclick="() => QuickAdd(magnet)" title="@name">@name</button>
                }
                <button class="qb-chip" @onclick="SeedTestData" title="Seed random test data">Seed Test</button>
                <button class="qb-chip" @onclick="SeedFileFromPicker" title="Seed a file from disk">Seed File</button>
            </div>
        </div>
        <div class="qb-toolbar-actions">
            <button class="qb-btn qb-btn-sm" @onclick="PauseAll" title="Pause All">&#9646;&#9646; All</button>
            <button class="qb-btn qb-btn-sm" @onclick="ResumeAll" title="Resume All">&#9654; All</button>
            <button class="qb-btn qb-btn-sm" @onclick="() => _showSettings = true" title="Settings">&#9881;</button>
            <div class="qb-speed-bar">
                <span class="qb-speed-down" title="Global download speed">&#x25BC; @FormatSpeed(_globalDownSpeed)</span>
                <span class="qb-speed-up" title="Global upload speed">&#x25B2; @FormatSpeed(_globalUpSpeed)</span>
            </div>
        </div>
    </div>

    @* ============ BODY (sidebar + content) ============ *@
    <div class="qb-body">
        @* ---- Sidebar ---- *@
        <div class="qb-sidebar">
            @foreach (var f in _filters)
            {
                var filter = f;
                int count = filter.Key == "all" ? Client.Torrents.Count
                    : filter.Key == "downloading" ? Client.Torrents.Count(t => !t.Done && !t.Paused && !t.Destroyed)
                    : filter.Key == "seeding" ? Client.Torrents.Count(t => t.Done && !t.Paused)
                    : Client.Torrents.Count(t => t.Paused);
                <div class="qb-sidebar-item @(filter.Key == _activeFilter ? "active" : "")"
                     @onclick="() => _activeFilter = filter.Key">
                    <span>@filter.Value</span>
                    <span class="qb-count">@count</span>
                </div>
            }
        </div>

        @* ---- Main content ---- *@
        <div class="qb-content">
            <div class="qb-list">
                @if (FilteredTorrents.Count == 0)
                {
                    <div class="qb-empty">
                        <div style="font-size:2.5rem;margin-bottom:8px;">&#128279;</div>
                        <div>No torrents yet</div>
                        <div style="font-size:11px;margin-top:4px;">Paste a magnet URI or click a quick-add chip above</div>
                    </div>
                }
                else
                {
                    <table class="qb-table">
                        <thead>
                            <tr>
                                <th class="qb-col-status"></th>
                                <th class="qb-col-name">Name</th>
                                <th class="qb-col-size qb-mono">Size</th>
                                <th class="qb-col-progress">Progress</th>
                                <th class="qb-col-speed qb-mono">DL</th>
                                <th class="qb-col-speed qb-mono">UL</th>
                                <th class="qb-col-eta qb-mono">ETA</th>
                                <th class="qb-col-peers qb-mono">Peers</th>
                                <th class="qb-col-ratio qb-mono">Ratio</th>
                                <th class="qb-col-actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in FilteredTorrents)
                            {
                                var torrent = t;
                                bool isSel = _selected == torrent;
                                <tr class="@(isSel ? "selected" : "") @(torrent.Paused ? "paused" : "")"
                                    @onclick="() => SelectTorrent(torrent)"
                                    @oncontextmenu="(e) => ShowContextMenu(e, torrent)" @oncontextmenu:preventDefault>
                                    <td class="qb-col-status">
                                        <span class="qb-status-dot @(GetStatusDotClass(torrent))" title="@GetStatusText(torrent)"></span>
                                    </td>
                                    <td class="qb-col-name" title="@(torrent.Name ?? torrent.InfoHash)">
                                        @(torrent.Name ?? torrent.InfoHash?[..Math.Min(12, torrent.InfoHash?.Length ?? 0)] ?? "unknown")
                                    </td>
                                    <td class="qb-col-size qb-mono">@(torrent.HasMetadata ? FormatSize(torrent.Length) : "---")</td>
                                    <td class="qb-col-progress">
                                        <div class="qb-progress">
                                            <div class="qb-progress-fill @(torrent.Done ? "done" : "")"
                                                 style="width:@((torrent.Progress * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                            <div class="qb-progress-label">@((torrent.Progress * 100).ToString("F1"))%</div>
                                        </div>
                                    </td>
                                    <td class="qb-col-speed qb-mono">@(torrent.DownloadSpeed > 0 ? FormatSpeed(torrent.DownloadSpeed) : "")</td>
                                    <td class="qb-col-speed qb-mono">@(torrent.UploadSpeed > 0 ? FormatSpeed(torrent.UploadSpeed) : "")</td>
                                    <td class="qb-col-eta qb-mono">@FormatEta(torrent)</td>
                                    <td class="qb-col-peers qb-mono">@torrent.PeerCount</td>
                                    <td class="qb-col-ratio qb-mono">@torrent.Ratio.ToString("F2")</td>
                                    <td class="qb-col-actions">
                                        @if (torrent.Paused)
                                        {
                                            <button class="qb-icon-btn" @onclick="() => torrent.Resume()" @onclick:stopPropagation title="Resume">&#9654;</button>
                                        }
                                        else
                                        {
                                            <button class="qb-icon-btn" @onclick="() => torrent.Pause()" @onclick:stopPropagation title="Pause">&#9646;&#9646;</button>
                                        }
                                        <button class="qb-icon-btn qb-icon-delete" @onclick="() => PromptRemove(torrent)" @onclick:stopPropagation title="Remove">&#10005;</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @* ============ DETAIL PANEL ============ *@
            @if (_selected != null)
            {
                var sel = _selected;
                <div class="qb-detail">
                    <div class="qb-tabs">
                        @foreach (var tab in _detailTabs)
                        {
                            var t = tab;
                            <button class="qb-tab @(_activeTab == t ? "active" : "")" @onclick="() => _activeTab = t">@t</button>
                        }
                    </div>
                    <div class="qb-tab-body">
                        @if (_activeTab == "General")
                        {
                            <div class="qb-info-grid">
                                <div class="qb-info-row"><span class="qb-label">Name</span><span>@(sel.Name ?? "---")</span></div>
                                <div class="qb-info-row"><span class="qb-label">Size</span><span class="qb-mono">@(sel.HasMetadata ? FormatSize(sel.Length) : "---")</span></div>
                                <div class="qb-info-row"><span class="qb-label">Downloaded</span><span class="qb-mono">@FormatSize(sel.Downloaded)</span></div>
                                <div class="qb-info-row"><span class="qb-label">Uploaded</span><span class="qb-mono">@FormatSize(sel.Uploaded)</span></div>
                                <div class="qb-info-row"><span class="qb-label">DL Speed</span><span class="qb-mono qb-speed-down">@FormatSpeed(sel.DownloadSpeed)</span></div>
                                <div class="qb-info-row"><span class="qb-label">UL Speed</span><span class="qb-mono qb-speed-up">@FormatSpeed(sel.UploadSpeed)</span></div>
                                <div class="qb-info-row"><span class="qb-label">Progress</span><span class="qb-mono">@((sel.Progress * 100).ToString("F2"))%</span></div>
                                <div class="qb-info-row"><span class="qb-label">Ratio</span><span class="qb-mono">@sel.Ratio.ToString("F3")</span></div>
                                <div class="qb-info-row"><span class="qb-label">Peers</span><span class="qb-mono">@sel.PeerCount (+ @sel.WebSeedCount web seeds)</span></div>
                                <div class="qb-info-row"><span class="qb-label">Pieces</span><span class="qb-mono">@sel.CompletedPieces / @sel.PieceCount (@(sel.HasMetadata ? FormatSize(sel.PieceLength) : "---") each)</span></div>
                                <div class="qb-info-row"><span class="qb-label">Strategy</span><span class="qb-mono">@sel.Strategy</span></div>
                                <div class="qb-info-row"><span class="qb-label">Status</span><span>@GetStatusText(sel)</span></div>
                                <div class="qb-info-row"><span class="qb-label">Private</span><span>@(sel.IsPrivate ? "Yes" : "No")</span></div>
                                @if (!string.IsNullOrEmpty(sel.Comment))
                                {
                                    <div class="qb-info-row"><span class="qb-label">Comment</span><span>@sel.Comment</span></div>
                                }
                                @if (!string.IsNullOrEmpty(sel.CreatedBy))
                                {
                                    <div class="qb-info-row"><span class="qb-label">Created By</span><span>@sel.CreatedBy</span></div>
                                }
                                @if (sel.CreationDate.HasValue)
                                {
                                    <div class="qb-info-row"><span class="qb-label">Created</span><span>@sel.CreationDate.Value.LocalDateTime.ToString("g")</span></div>
                                }
                            </div>
                            <div class="qb-info-row" style="margin-top:4px;"><span class="qb-label">Info Hash</span><span class="qb-hash qb-mono">@(sel.InfoHash ?? "---")</span></div>

                            <div class="qb-magnet-row">
                                <span class="qb-label" style="white-space:nowrap;">Magnet</span>
                                <span class="qb-magnet-display qb-mono" @onclick="() => CopyToClipboard(sel.ComputedMagnetUri)" title="Click to copy">
                                    @TruncateMagnet(sel.ComputedMagnetUri)
                                </span>
                                <button class="qb-action-btn" @onclick="() => CopyToClipboard(sel.ComputedMagnetUri)">Copy</button>
                            </div>

                            <div class="qb-action-row">
                                @if (sel.Paused)
                                {
                                    <button class="qb-action-btn" @onclick="() => sel.Resume()">&#9654; Resume</button>
                                }
                                else
                                {
                                    <button class="qb-action-btn" @onclick="() => sel.Pause()">&#9646;&#9646; Pause</button>
                                }
                                @if (sel.TorrentFileBytes != null)
                                {
                                    <button class="qb-action-btn" @onclick="() => ExportTorrentFile(sel)">&#128190; Export .torrent</button>
                                }
                                <button class="qb-action-btn" style="margin-left:auto;color:#f87171;border-color:rgba(239,68,68,.3);"
                                        @onclick="() => PromptRemove(sel)">&#10005; Remove</button>
                            </div>

                            @* ---- Speed Sparklines ---- *@
                            <div style="display:flex;gap:16px;flex-wrap:wrap;">
                                <div style="flex:1;min-width:200px;">
                                    <div class="qb-sparkline-label">Download Speed (60s)</div>
                                    <svg class="qb-sparkline" viewBox="0 0 300 40" preserveAspectRatio="none">
                                        @{ var dlHist = sel.DownloadSpeedHistory; }
                                        @if (dlHist.Count > 1)
                                        {
                                            <polyline fill="none" stroke="#10b981" stroke-width="1.5"
                                                      points="@SparklinePoints(dlHist, 300, 40)" />
                                        }
                                    </svg>
                                </div>
                                <div style="flex:1;min-width:200px;">
                                    <div class="qb-sparkline-label">Upload Speed (60s)</div>
                                    <svg class="qb-sparkline" viewBox="0 0 300 40" preserveAspectRatio="none">
                                        @{ var ulHist = sel.UploadSpeedHistory; }
                                        @if (ulHist.Count > 1)
                                        {
                                            <polyline fill="none" stroke="#3b82f6" stroke-width="1.5"
                                                      points="@SparklinePoints(ulHist, 300, 40)" />
                                        }
                                    </svg>
                                </div>
                            </div>

                            @* ---- Piece Grid (1:1 mapping up to 2000 pieces) ---- *@
                            @if (sel.Bitfield.Length > 0)
                            {
                                <div class="qb-piece-label">Pieces (@sel.CompletedPieces / @sel.PieceCount)</div>
                                <div class="qb-piece-bar">
                                    @{
                                        int total = sel.Bitfield.Length;
                                        int cols = Math.Min(total, 2000);
                                        int pieceStep = Math.Max(1, total / cols);
                                    }
                                    @for (int i = 0; i < cols; i++)
                                    {
                                        int start = i * pieceStep;
                                        int end = Math.Min((i + 1) * pieceStep, total);
                                        int done = 0; int count = 0;
                                        for (int j = start; j < end; j++) { count++; if (sel.Bitfield[j]) done++; }
                                        var cls = done == 0 ? "" : done == count ? "qb-piece-have" : "qb-piece-partial";
                                        <span class="qb-piece @cls"></span>
                                    }
                                </div>
                            }
                        }
                        else if (_activeTab == "Trackers")
                        {
                            @if (sel.AnnounceUrls.Length == 0)
                            {
                                <div class="qb-muted" style="padding:16px;">No trackers</div>
                            }
                            else
                            {
                                <table class="qb-sub-table">
                                    <thead>
                                        <tr>
                                            <th>URL</th>
                                            <th style="width:80px;">Type</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var url in sel.AnnounceUrls)
                                        {
                                            <tr>
                                                <td class="qb-mono" style="word-break:break-all;">@url</td>
                                                <td>@GetTrackerType(url)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                        else if (_activeTab == "Peers")
                        {
                            @if (sel.Wires.Count == 0)
                            {
                                <div class="qb-muted" style="padding:16px;">No peers connected</div>
                            }
                            else
                            {
                                <table class="qb-sub-table">
                                    <thead>
                                        <tr>
                                            <th>Peer ID</th>
                                            <th>Address</th>
                                            <th style="width:60px;">Type</th>
                                            <th style="width:70px;">DL</th>
                                            <th style="width:70px;">UL</th>
                                            <th style="width:60px;">Progress</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var wire in sel.Wires.ToArray())
                                        {
                                            var dl = wire.DownloadSpeed();
                                            var ul = wire.UploadSpeed();
                                            var peerId = wire.Type == "webSeed" && wire.RemoteAddress != null
                                                ? (Uri.TryCreate(wire.RemoteAddress, UriKind.Absolute, out var uri) ? uri.Host : wire.RemoteAddress)
                                                : wire.PeerId;
                                            <tr>
                                                <td class="qb-mono" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;">
                                                    @(peerId?.Length > 20 ? peerId[..20] + "..." : peerId ?? "---")
                                                </td>
                                                <td class="qb-mono" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;">
                                                    @(wire.RemoteAddress ?? "---")
                                                </td>
                                                <td>@(wire.Type == "webSeed" ? "WebSeed" : "WebRTC")</td>
                                                <td class="qb-mono">@(dl > 0 ? FormatSpeed(dl) : "")</td>
                                                <td class="qb-mono">@(ul > 0 ? FormatSpeed(ul) : "")</td>
                                                <td class="qb-mono">@(wire.PeerHasAll ? "100%" : "---")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                        else if (_activeTab == "Content")
                        {
                            @if (sel.Files == null || sel.Files.Length == 0)
                            {
                                <div class="qb-muted" style="padding:16px;">@(sel.HasMetadata ? "No files" : "Waiting for metadata...")</div>
                            }
                            else
                            {
                                <table class="qb-sub-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th class="qb-col-ftype">Type</th>
                                            <th class="qb-col-fsize">Size</th>
                                            <th class="qb-col-fprog-wide">Progress</th>
                                            <th class="qb-col-fdl">Downloaded</th>
                                            <th class="qb-col-fpri">Priority</th>
                                            <th style="width:40px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var file in sel.Files)
                                        {
                                            var f = file;
                                            <tr class="@(f.Done ? "qb-file-done" : "")">
                                                <td title="@f.Path" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                                    @f.Name
                                                </td>
                                                <td class="qb-col-ftype">
                                                    <span class="qb-ext">@GetFileExtension(f.Name)</span>
                                                </td>
                                                <td class="qb-col-fsize qb-mono">@FormatSize(f.Length)</td>
                                                <td class="qb-col-fprog-wide">
                                                    <div class="qb-file-progress">
                                                        <div class="qb-file-progress-fill @(f.Done ? "done" : "")"
                                                             style="width:@((f.Progress * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                                        <div class="qb-file-progress-label">@((f.Progress * 100).ToString("F1"))%</div>
                                                    </div>
                                                </td>
                                                <td class="qb-col-fdl qb-mono">@FormatSize(f.Downloaded)</td>
                                                <td class="qb-col-fpri">
                                                    <select class="qb-pri-select" @onchange="(e) => SetFilePriority(f, e)">
                                                        <option value="normal" selected>Normal</option>
                                                        <option value="high">High</option>
                                                        <option value="skip">Skip</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    @if (f.Done && IsMediaType(f.Type))
                                                    {
                                                        <button class="qb-play-btn" @onclick="() => PlayMedia(sel, f)" title="Play">&#9654;</button>
                                                    }
                                                    @if (f.Done)
                                                    {
                                                        <button class="qb-icon-btn" @onclick="() => DownloadFile(sel, f)" title="Download">&#128190;</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                        else if (_activeTab == "Log")
                        {
                            <div class="qb-log">
                                @if (_logLines.Count == 0)
                                {
                                    <div class="qb-muted" style="padding:16px;">No log entries</div>
                                }
                                else
                                {
                                    @foreach (var line in _logLines.AsEnumerable().Reverse().Take(200))
                                    {
                                        <div class="qb-log-line @line.Css">@line.Time @line.Text</div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ============ STATUS BAR ============ *@
    <div class="qb-statusbar">
        <span>Torrents: @Client.Torrents.Count</span>
        <span>Peers: @Client.Torrents.Sum(t => t.PeerCount)</span>
        <span class="qb-speed-down">&#x25BC; @FormatSpeed(_globalDownSpeed)</span>
        <span class="qb-speed-up">&#x25B2; @FormatSpeed(_globalUpSpeed)</span>
        <span>DL: @FormatSize(Client.Torrents.Sum(t => t.Downloaded))</span>
        <span>UL: @FormatSize(Client.Torrents.Sum(t => t.Uploaded))</span>
        <span style="margin-left:auto;">Storage: MEM</span>
        <span>Peer ID: @_peerIdStr</span>
        <span>v@_version</span>
    </div>
</div>

@* ============ CONTEXT MENU ============ *@
@if (_ctxVisible && _ctxTorrent != null)
{
    <div class="qb-ctx-backdrop" @onclick="CloseContextMenu"></div>
    <div class="qb-ctx-menu" style="left:@(_ctxX)px;top:@(_ctxY)px;">
        @if (_ctxTorrent.Paused)
        {
            <div class="qb-ctx-item" @onclick="() => { _ctxTorrent.Resume(); CloseContextMenu(); }">&#9654; Resume</div>
        }
        else
        {
            <div class="qb-ctx-item" @onclick="() => { _ctxTorrent.Pause(); CloseContextMenu(); }">&#9646;&#9646; Pause</div>
        }
        <div class="qb-ctx-item" @onclick="() => { CopyToClipboard(_ctxTorrent.ComputedMagnetUri); CloseContextMenu(); }">&#128279; Copy Magnet</div>
        @if (_ctxTorrent.TorrentFileBytes != null)
        {
            <div class="qb-ctx-item" @onclick="() => { ExportTorrentFile(_ctxTorrent); CloseContextMenu(); }">&#128190; Export .torrent</div>
        }
        <div class="qb-ctx-item" @onclick="() => ShowProperties(_ctxTorrent)">&#9432; Properties</div>
        <div class="qb-ctx-sep"></div>
        <div class="qb-ctx-item qb-ctx-danger" @onclick="() => { PromptRemove(_ctxTorrent); CloseContextMenu(); }">&#10005; Remove</div>
    </div>
}

@* ============ REMOVE CONFIRMATION DIALOG ============ *@
@if (_showRemoveDialog && _removeTorrent != null)
{
    <div class="qb-overlay" @onclick="() => _showRemoveDialog = false">
        <div class="qb-modal" style="width:360px;" @onclick:stopPropagation>
            <div class="qb-modal-header">
                <span>Remove Torrent</span>
                <button class="qb-icon-btn" @onclick="() => _showRemoveDialog = false">&#10005;</button>
            </div>
            <div class="qb-modal-body">
                <p style="color:#e2e8f0;font-size:13px;margin:0 0 12px;">
                    Remove <strong>@(_removeTorrent.Name ?? _removeTorrent.InfoHash)</strong>?
                </p>
                <div style="display:flex;gap:8px;justify-content:flex-end;">
                    <button class="qb-btn" @onclick="() => RemoveTorrent(false)">Keep Data</button>
                    <button class="qb-btn" style="color:#f87171;border:1px solid rgba(239,68,68,.3);"
                            @onclick="() => RemoveTorrent(true)">Delete Data</button>
                    <button class="qb-btn" @onclick="() => _showRemoveDialog = false">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@* ============ SETTINGS MODAL ============ *@
@if (_showSettings)
{
    <div class="qb-overlay" @onclick="() => _showSettings = false">
        <div class="qb-modal qb-modal-settings" @onclick:stopPropagation>
            <div class="qb-modal-header">
                <span>&#9881; Settings</span>
                <button class="qb-icon-btn" @onclick="() => _showSettings = false">&#10005;</button>
            </div>
            <div class="qb-modal-body" style="max-height:500px;overflow-y:auto;">
                <h4>Transfer</h4>
                <div class="qb-setting">
                    <label>Download Limit (KB/s)</label>
                    <input class="qb-input qb-input-sm" type="number" min="0" @bind="_settingsDlLimit" style="width:80px;" />
                </div>
                <div class="qb-setting">
                    <label>Upload Limit (KB/s)</label>
                    <input class="qb-input qb-input-sm" type="number" min="0" @bind="_settingsUlLimit" style="width:80px;" />
                </div>
                <div class="qb-muted" style="font-size:10px;margin-left:140px;">0 = unlimited</div>

                <h4>Connections</h4>
                <div class="qb-setting">
                    <label>Max Connections</label>
                    <input class="qb-input qb-input-sm" type="number" min="1" @bind="Client.MaxConns" style="width:60px;" />
                </div>
                <div class="qb-setting"><label>Trackers</label><label class="qb-toggle"><input type="checkbox" @bind="Client.EnableTrackers" /> @(Client.EnableTrackers ? "On" : "Off")</label></div>
                <div class="qb-setting"><label>Peer Exchange (BEP 11)</label><label class="qb-toggle"><input type="checkbox" @bind="Client.EnableUtPex" /> @(Client.EnableUtPex ? "On" : "Off")</label></div>
                <div class="qb-setting"><label>Web Seeds (BEP 19)</label><label class="qb-toggle"><input type="checkbox" @bind="Client.EnableWebSeeds" /> @(Client.EnableWebSeeds ? "On" : "Off")</label></div>

                <h4>Default Trackers</h4>
                <textarea class="qb-input" style="width:100%;height:80px;font-family:Consolas;font-size:11px;" @bind="_settingsTrackers"></textarea>
                <div class="qb-muted" style="font-size:10px;">One per line. Applied to new torrents.</div>

                <h4>Client</h4>
                <div class="qb-setting"><label>Peer ID</label><span class="qb-mono" style="font-size:10px;word-break:break-all;">@Client.PeerId</span></div>
                <div class="qb-setting"><label>Version</label><span>@_version</span></div>
                <div class="qb-setting"><label>Platform</label><span>Blazor WebAssembly / Browser WebRTC</span></div>
                <div class="qb-setting"><label>BEPs</label><span style="font-size:11px;">3, 5, 6, 9, 10, 11, 14, 15, 17, 19, 20, 23, 27, 44, 46, 48, 53</span></div>

                <div style="text-align:right;margin-top:12px;">
                    <button class="qb-btn" @onclick="ApplySettings">Apply</button>
                </div>
            </div>
        </div>
    </div>
}

@* ============ MEDIA PLAYER MODAL ============ *@
@if (_showMediaModal)
{
    <div class="qb-overlay" @onclick="CloseMedia">
        <div class="qb-modal" style="max-width:900px;width:90vw;" @onclick:stopPropagation>
            <div class="qb-modal-header">
                <span>@_mediaFileName</span>
                <button class="qb-icon-btn" @onclick="CloseMedia">&#10005;</button>
            </div>
            <div class="qb-modal-body" style="text-align:center;padding:8px;">
                @if (_mediaLoading)
                {
                    <p style="color:#94a3b8;padding:2rem;">Loading @_mediaFileName...</p>
                }
                else if (!string.IsNullOrEmpty(_mediaBlobUrl))
                {
                    @if (_mediaType == "video")
                    {
                        <video src="@_mediaBlobUrl" controls autoplay style="width:100%;max-height:65vh;border-radius:4px;background:black;"></video>
                    }
                    else if (_mediaType == "audio")
                    {
                        <audio src="@_mediaBlobUrl" controls autoplay style="width:100%;"></audio>
                    }
                    else if (_mediaType == "image")
                    {
                        <img src="@_mediaBlobUrl" style="max-width:100%;max-height:70vh;object-fit:contain;border-radius:4px;" />
                    }
                }
                else
                {
                    <p style="color:#fca5a5;padding:2rem;">Failed to load media</p>
                }
            </div>
        </div>
    </div>
}

@* ============ TOAST ============ *@
@if (_toastVisible)
{
    <div class="qb-toast @(_toastFading ? "qb-toast-fade" : "")">
        <span>&#9989;</span>
        <span>@_toastMessage</span>
    </div>
}

