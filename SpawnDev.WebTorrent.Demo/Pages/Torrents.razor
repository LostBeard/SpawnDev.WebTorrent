    private async Task SeedTestData()
    {
        try
        {
            var rng = new Random();
            var data = new byte[64 * 1024]; // 64 KB test data
            rng.NextBytes(data);
            var name = $"test-{DateTime.UtcNow:HHmmss}.bin";
            var torrent = await Client.SeedAsync(name, data, new TorrentCreatorOptions
            {
                Trackers = new[] { "wss://hub.spawndev.com:44365/announce", "wss://tracker.openwebtorrent.com" },
            });
            _selected = torrent;
            AddLog($"Seeding test: {torrent.Name} ({FormatSize(torrent.Length)})", "qb-log-done");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            AddLog($"Seed test error: {ex.Message}", "qb-log-err");
        }
    }

    private async Task SeedFileFromPicker()
    {
        try
        {
            using var window = JS.Get<Window>("window");
            using var handles = await window.ShowOpenFilePicker(new ShowOpenFilePickerOptions { Multiple = false });
            if (handles == null || handles.Length == 0) return;
            using var handle = handles[0];
            using var file = await handle.GetFile();
            using var arrayBuffer = await file.ArrayBuffer();
            using var uint8 = new Uint8Array(arrayBuffer);
            var data = uint8.ReadBytes();
            var torrent = await Client.SeedAsync(file.Name, data, new TorrentCreatorOptions
            {
                Trackers = new[] { "wss://hub.spawndev.com:44365/announce", "wss://tracker.openwebtorrent.com" },
            });
            _selected = torrent;
            AddLog($"Seeding file: {torrent.Name} ({FormatSize(torrent.Length)})", "qb-log-done");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (!ex.Message.Contains("aborted"))
                AddLog($"Seed file error: {ex.Message}", "qb-log-err");
        }
    }

    private async Task OnTorrentFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            var torrentBytes = ms.ToArray();
            var torrent = Client.Add(torrentBytes);
            _selected = torrent;
            AddLog($"Opened .torrent: {torrent.Name ?? torrent.InfoHash ?? "unknown"}", "qb-log-tracker");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            AddLog($"Error opening .torrent: {ex.Message}", "qb-log-err");
        }
    }

    private void SelectTorrent(Torrent torrent)
    {
        _selected = torrent;
    }

    private void ApplySettings()
    {
        Client.ThrottleDownload(_settingsDlLimit <= 0 ? -1 : _settingsDlLimit * 1024);
        Client.ThrottleUpload(_settingsUlLimit <= 0 ? -1 : _settingsUlLimit * 1024);
        var trackerLines = _settingsTrackers.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        Client.DefaultTrackers = trackerLines.Where(t => t.StartsWith("wss://") || t.StartsWith("ws://")).ToArray();
        _showSettings = false;
        AddLog("Settings applied", "");
    }

    private void PauseAll()
    {
        foreach (var t in Client.Torrents) t.Pause();
        AddLog("All torrents paused", "");
    }

    private void ResumeAll()
    {
        foreach (var t in Client.Torrents) t.Resume();
        AddLog("All torrents resumed", "");
    }

    private void PromptRemove(Torrent torrent)
    {
        _removeTorrent = torrent;
        _showRemoveDialog = true;
    }

    private async Task RemoveTorrent(bool deleteData)
    {
        if (_removeTorrent == null) return;
        var name = _removeTorrent.Name ?? _removeTorrent.InfoHash ?? "unknown";
        if (deleteData)
            await Client.RemoveWithDataAsync(_removeTorrent);
        else
            await Client.RemoveAsync(_removeTorrent);
        _showRemoveDialog = false;
        _removeTorrent = null;
        AddLog($"Removed: {name} (data {(deleteData ? "deleted" : "kept")})", "");
    }

    private void SetFilePriority(TorrentFileInfo file, ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "normal";
        if (val == "skip")
            file.Deselect();
        else
            file.Select();
    }

    private async Task ExportTorrentFile(Torrent torrent)
    {
        if (torrent.TorrentFileBytes == null) return;
        try
        {
            var base64 = Convert.ToBase64String(torrent.TorrentFileBytes);
            var fileName = $"{torrent.Name ?? torrent.InfoHash ?? "torrent"}.torrent";
            await JS.CallVoidAsync("eval", $@"
                var a = document.createElement('a');
                a.href = 'data:application/x-bittorrent;base64,{base64}';
                a.download = '{fileName.Replace("'", "\\'")}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            ");
            AddLog($"Exported: {fileName}", "");
        }
        catch (Exception ex)
        {
            AddLog($"Export error: {ex.Message}", "qb-log-err");
        }
    }

    private async Task CopyToClipboard(string text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.CallVoidAsync("navigator.clipboard.writeText", text);
            ShowToast("Copied to clipboard");
        }
        catch
        {
            AddLog("Clipboard access denied", "qb-log-err");
        }
    }

    private async Task PlayMedia(Torrent torrent, TorrentFileInfo file)
    {
        if (torrent.Files == null) return;

        _mediaFileName = file.Name;
        _mediaLoading = true;
        _showMediaModal = true;
        _mediaBlobUrl = "";
        StateHasChanged();

        try
        {
            // Use service worker streaming URL — supports seeking and streams while downloading.
            // No need to wait for file.Done — pieces download on demand as the media plays.
            var streamUrl = file.StreamURL;
            if (!string.IsNullOrEmpty(streamUrl))
            {
                _mediaBlobUrl = streamUrl;
                _mediaType = file.Type.StartsWith("video") ? "video" : file.Type.StartsWith("audio") ? "audio" : "image";
                AddLog($"Streaming: {file.Name} ({FormatSize(file.Length)})", "qb-log-done");
            }
            else
            {
                // Fallback for desktop or when SW not available: blob URL (requires full download)
                if (!file.Done) { AddLog("File not complete and streaming not available", "qb-log-err"); _showMediaModal = false; return; }
                var fileIndex = System.Array.IndexOf(torrent.Files, file);
                var data = await torrent.ReadFileAsync(fileIndex);
                using var blob = new Blob(new[] { data }, new BlobOptions { Type = file.Type });
                _mediaBlobUrl = URL.CreateObjectURL(blob);
                _mediaType = file.Type.StartsWith("video") ? "video" : file.Type.StartsWith("audio") ? "audio" : "image";
                AddLog($"Playing: {file.Name} ({FormatSize(file.Length)})", "qb-log-done");
            }
        }
        catch (Exception ex)
        {
            AddLog($"Playback error: {ex.Message}", "qb-log-err");
            _showMediaModal = false;
        }
        finally
        {
            _mediaLoading = false;
            StateHasChanged();
        }
    }

    private void CloseMedia()
    {
        _showMediaModal = false;
        if (!string.IsNullOrEmpty(_mediaBlobUrl))
        {
            try { URL.RevokeObjectURL(_mediaBlobUrl); } catch { }
            _mediaBlobUrl = "";
        }
    }

    private async Task DownloadFile(Torrent torrent, TorrentFileInfo file)
    {
        if (!file.Done || torrent.Files == null) return;
        var fileIndex = System.Array.IndexOf(torrent.Files, file);
        if (fileIndex < 0) return;

        try
        {
            AddLog($"Reading file: {file.Name}...", "qb-log-piece");
            var data = await torrent.ReadFileAsync(fileIndex);
            using var blob = new Blob(new[] { data }, new BlobOptions { Type = file.Type });
            var url = URL.CreateObjectURL(blob);
            var safeName = file.Name.Replace("'", "\\'");
            await JS.CallVoidAsync("eval", $"var a=document.createElement('a');a.href='{url}';a.download='{safeName}';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL('{url}')");
            AddLog($"Downloaded: {file.Name} ({FormatSize(file.Length)})", "qb-log-done");
        }
        catch (Exception ex)
        {
            AddLog($"Download error: {ex.Message}", "qb-log-err");
        }
    }

    // ========================
    // CONTEXT MENU
    // ========================
    private void ShowContextMenu(MouseEventArgs e, Torrent torrent)
    {
        _ctxTorrent = torrent;
        _ctxX = e.ClientX;
        _ctxY = e.ClientY;
        _ctxVisible = true;
    }

    private void CloseContextMenu()
    {
        _ctxVisible = false;
        _ctxTorrent = null;
    }

    private void ShowProperties(Torrent? torrent)
    {
        if (torrent != null)
        {
            SelectTorrent(torrent);
            _activeTab = "General";
        }
        CloseContextMenu();
    }

    // ========================
    // KEYBOARD SHORTCUTS
    // ========================
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_selected == null) return;

        if (e.Key == "Delete")
        {
            PromptRemove(_selected);
        }
        else if (e.Key == " ")
        {
            if (_selected.Paused) _selected.Resume();
            else _selected.Pause();
        }
        else if (e.Key == "c" && e.CtrlKey)
        {
            await CopyToClipboard(_selected.ComputedMagnetUri);
        }
    }

    private async Task OnMagnetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddMagnet();
    }

    // ========================
    // DRAG AND DROP
    // ========================
    private void OnDragOver(DragEventArgs e)
    {
        // Allow drop
    }

    private void OnDrop(DragEventArgs e)
    {
        // Try to extract magnet URI from dropped text
        var text = e.DataTransfer?.Items?.FirstOrDefault()?.Type;
        // DataTransfer text extraction requires JS interop in Blazor; use the magnet input as fallback
    }

    // ========================
    // TOAST
    // ========================
    private async void ShowToast(string message)
    {
        _toastMessage = message;
        _toastVisible = true;
        _toastFading = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2500);
        _toastFading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(500);
        _toastVisible = false;
        _toastFading = false;
        await InvokeAsync(StateHasChanged);
    }

    // ========================
    // LOG
    // ========================
    private void AddLog(string text, string css)
    {
        var time = DateTime.Now.ToString("HH:mm:ss");
        _logLines.Add(new LogLine { Time = time, Text = text, Css = css });
        if (_logLines.Count > 500)
            _logLines.RemoveRange(0, _logLines.Count - 500);
    }

    private record LogLine
    {
        public string Time { get; init; } = "";
        public string Text { get; init; } = "";
        public string Css { get; init; } = "";
    }

    // ========================
    // FORMATTING HELPERS
    // ========================
    private static string FormatSize(long bytes)
    {
        if (bytes < 0) bytes = 0;
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1) { order++; len /= 1024; }
        return $"{len:0.##} {sizes[order]}";
    }

    private static string FormatSpeed(double bytesPerSec)
    {
        if (bytesPerSec <= 0) return "0 B/s";
        string[] sizes = { "B/s", "KB/s", "MB/s", "GB/s" };
        double val = bytesPerSec;
        int order = 0;
        while (val >= 1024 && order < sizes.Length - 1) { order++; val /= 1024; }
        return $"{val:0.#} {sizes[order]}";
    }

    private static string FormatEta(Torrent t)
    {
        if (t.Done) return "";
        if (t.Paused) return "Paused";
        if (!t.HasMetadata) return "---";
        if (t.DownloadSpeed <= 0) return "Stalled";
        long remaining = t.Length - t.Downloaded;
        if (remaining <= 0) return "";
        long seconds = (long)(remaining / t.DownloadSpeed);
        if (seconds < 60) return $"{seconds}s";
        if (seconds < 3600) return $"{seconds / 60}m {seconds % 60}s";
        if (seconds < 86400) return $"{seconds / 3600}h {(seconds % 3600) / 60}m";
        return $"{seconds / 86400}d {(seconds % 86400) / 3600}h";
    }

    private static string GetStatusText(Torrent t)
    {
        if (t.Destroyed) return "Destroyed";
        if (t.Paused) return "Paused";
        if (!t.HasMetadata) return "Fetching metadata...";
        if (t.Done) return "Seeding";
        if (t.DownloadSpeed > 0) return "Downloading";
        return "Stalled";
    }

    private static string GetStatusDotClass(Torrent t)
    {
        if (t.Paused) return "qb-dot-paused";
        if (!t.HasMetadata) return "qb-dot-meta";
        if (t.Done) return "qb-dot-seed";
        return "qb-dot-dl";
    }

    private static string GetTrackerType(string url)
    {
        if (url.StartsWith("wss://")) return "WSS";
        if (url.StartsWith("ws://")) return "WS";
        if (url.StartsWith("udp://")) return "UDP";
        if (url.StartsWith("http")) return "HTTP";
        return "?";
    }

    private static string GetFileExtension(string name)
    {
        var dot = name.LastIndexOf('.');
        return dot >= 0 ? name[dot..] : "";
    }

    private static bool IsMediaType(string mimeType)
    {
        return mimeType.StartsWith("video/") || mimeType.StartsWith("audio/") || mimeType.StartsWith("image/");
    }

    private static string TruncateMagnet(string magnet)
    {
        if (string.IsNullOrEmpty(magnet)) return "---";
        return magnet.Length > 100 ? magnet[..100] + "..." : magnet;
    }

    private static string SparklinePoints(List<double> data, int width, int height)
    {
        if (data.Count < 2) return "";
        double max = data.Max();
        if (max <= 0) max = 1;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < data.Count; i++)
        {
            double x = (double)i / (data.Count - 1) * width;
            double y = height - (data[i] / max * (height - 2)) - 1;
            if (i > 0) sb.Append(' ');
            sb.Append($"{x:F1},{y:F1}");
        }
        return sb.ToString();
    }
}

