<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>3.1.7</Version>
		<PackageReleaseNotes>v3.1.7 stable: Version-sync with SpawnDev.WebTorrent 3.1.7. No source changes in WebTorrent.Server itself. WebTorrent 3.1.7 adds a new `TcpListenerService` for inbound BT peer connections (closes the seed-C# / leech-mainline audit gap) and ships two wire-level correctness fixes that benefit every consumer seeding to a pipelining leecher: `Wire._message` now sends header + data in a single buffer (was two separate writes that could interleave bytes between concurrent `SendPiece` responses, corrupting the wire and tripping mainline-client hash verification), and `TcpPeer.AttachAsync` is split from `StartReadLoop` to avoid a kernel-buffered-handshake drop race. See SpawnDev.WebTorrent 3.1.7 release notes for the full write-up.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Title>SpawnDev.WebTorrent.Server</Title>
		<Authors>LostBeard</Authors>
		<Description>Web seed server for SpawnDev.WebTorrent. Serves torrent pieces over HTTP range requests (BEP 17/19). Tracker functionality moved to SpawnDev.RTC.Server in 3.1.0 - consumers wire both with `app.UseRtcSignaling("/announce")` + the web seed extension from this package. No HuggingFace dependency - use SpawnDev.WebTorrent.Server.HuggingFace for AI model proxy.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.WebTorrent</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.WebTorrent.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>BitTorrent;WebTorrent;WebSeed;P2P;Server;ASP.NET</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.WebTorrent\SpawnDev.WebTorrent.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
	</ItemGroup>

</Project>
