<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>3.2.10</Version>
		<PackageReleaseNotes>v3.2.10: HuggingFaceProxy now clamps over-EOF Range request ends per RFC 7233 (via SpawnDev.WebTorrent.HttpByteRange) instead of honoring the last-byte-pos verbatim. A range past EOF used to over-promise Content-Length and stream a short body, which a browser fetch rejected as net::ERR_CONTENT_LENGTH_MISMATCH (the web-seed piece never verified); reproduced live against the hub. Also returns 416 for a start at/after EOF and fixes a >2GB int length overflow. Deployed + verified live on hub.spawndev.com. Requires SpawnDev.WebTorrent.Server 3.2.10.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Title>SpawnDev.WebTorrent.Server.HuggingFace</Title>
		<Authors>LostBeard</Authors>
		<Description>HuggingFace CDN proxy extension for SpawnDev.WebTorrent.Server. Fetches model files from HuggingFace's CDN on demand, caches locally, generates SHA-256 .torrent files, and serves as a BEP 17/19 web seed. Adds per-model request stats, LRU cache eviction, and configurable disk-headroom guards. Optional extension - SpawnDev.WebTorrent.Server works without it.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.WebTorrent</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageId>SpawnDev.WebTorrent.Server.HuggingFace</PackageId>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.WebTorrent.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>BitTorrent;WebTorrent;HuggingFace;P2P;ModelDelivery;MachineLearning;ASP.NET;WebSeed</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.WebTorrent.Server\SpawnDev.WebTorrent.Server.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
	</ItemGroup>

</Project>
