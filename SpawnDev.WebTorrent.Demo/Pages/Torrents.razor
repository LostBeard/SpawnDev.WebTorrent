@page "/torrents"
@using SpawnDev.WebTorrent
@using SpawnDev.WebTorrent.Torrent
@using SpawnDev.WebTorrent.Transports
@using SpawnDev.WebTorrent.Discovery
@using SpawnDev.WebTorrent.Storage
@using SpawnDev.WebTorrent.Wire
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@using SpawnDev.AsyncFileSystem
@inject BlazorJSRuntime JS
@implements IAsyncDisposable

<PageTitle>SpawnDev.WebTorrent Client</PageTitle>

<div class="tc-app">
    @* ═══ Top Toolbar ═══ *@
    <div class="tc-toolbar">
        <div class="tc-toolbar-left">
            <div class="tc-add-row">
                <input type="text" class="tc-input" placeholder="magnet:?xt=urn:btih:... or info hash"
                       @bind="_magnetInput" @bind:event="oninput" @onkeydown="OnMagnetKeyDown" />
                <button class="tc-btn tc-btn-accent" @onclick="AddMagnet" disabled="@(string.IsNullOrWhiteSpace(_magnetInput))">
                    + Add
                </button>
                <button class="tc-btn tc-btn-secondary" @onclick="ToggleSettings" title="Settings">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/><path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.892 3.434-.901 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115l.094-.319z"/></svg>
                </button>
            </div>
            <div class="tc-quick-row">
                @foreach (var (name, _) in CCMagnets)
                {
                    var n = name;
                    <button class="tc-chip" @onclick="() => QuickAdd(n)">@n</button>
                }
            </div>
        </div>
        <div class="tc-toolbar-right">
            <div class="tc-speed-display">
                <span class="tc-speed-down" title="Download speed">@FormatSpeed(_globalDownSpeed)</span>
                <span class="tc-speed-up" title="Upload speed">@FormatSpeed(_globalUpSpeed)</span>
            </div>
            <div class="tc-global-stats">
                <span>@_torrents.Count torrents</span>
                <span>@_torrents.Sum(t => t.Swarm.PeerCount) peers</span>
                <span class="tc-peerid">@PeerIdString</span>
            </div>
        </div>
    </div>

    @* ═══ Main Content ═══ *@
    <div class="tc-main">
        @* ── Torrent List ── *@
        <div class="tc-list-panel">
            @if (_torrents.Count == 0)
            {
                <div class="tc-empty">
                    <div class="tc-empty-icon">
                        <svg width="48" height="48" fill="#334155" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                    </div>
                    <p>Add a torrent to get started</p>
                    <p class="tc-empty-sub">Paste a magnet URI above or use the quick-add buttons</p>
                </div>
            }
            else
            {
                <table class="tc-table">
                    <thead>
                        <tr>
                            <th class="col-name">Name</th>
                            <th class="col-size">Size</th>
                            <th class="col-progress">Progress</th>
                            <th class="col-speed">Down</th>
                            <th class="col-speed">Up</th>
                            <th class="col-peers">Peers</th>
                            <th class="col-status">Status</th>
                            <th class="col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _torrents)
                        {
                            var e = entry;
                            var progress = e.PieceManager?.Progress ?? e.Swarm.Progress;
                            var isSelected = _selectedTorrent == e;
                            <tr class="@(isSelected ? "selected" : "")" @onclick="() => SelectTorrent(e)">
                                <td class="col-name">
                                    <span class="tc-torrent-name">@(e.Swarm.Metadata?.Name ?? e.Name ?? "Loading...")</span>
                                </td>
                                <td class="col-size">@(e.Swarm.HasMetadata ? FormatBytes(e.Swarm.Metadata!.TotalLength) : "—")</td>
                                <td class="col-progress">
                                    <div class="tc-progress-cell">
                                        <div class="tc-progress-bar-mini">
                                            <div class="tc-progress-fill" style="width: @((progress * 100).ToString("F1"))%"></div>
                                        </div>
                                        <span class="tc-progress-text">@((progress * 100).ToString("F1"))%</span>
                                    </div>
                                </td>
                                <td class="col-speed tc-speed-val">@(e.Swarm.DownloadSpeed > 0 ? FormatSpeed(e.Swarm.DownloadSpeed) : "—")</td>
                                <td class="col-speed tc-speed-val">@(e.Swarm.UploadSpeed > 0 ? FormatSpeed(e.Swarm.UploadSpeed) : "—")</td>
                                <td class="col-peers">@e.Swarm.PeerCount</td>
                                <td class="col-status">
                                    @if (e.PieceManager?.IsComplete == true)
                                    {
                                        <span class="tc-status tc-status-seeding">Seeding</span>
                                    }
                                    else if (e.PieceManager != null && e.PieceManager.CompletedCount > 0)
                                    {
                                        <span class="tc-status tc-status-downloading">Downloading</span>
                                    }
                                    else if (e.Swarm.HasMetadata)
                                    {
                                        <span class="tc-status tc-status-waiting">Waiting</span>
                                    }
                                    else
                                    {
                                        <span class="tc-status tc-status-meta">Metadata</span>
                                    }
                                </td>
                                <td class="col-actions">
                                    <button class="tc-btn-icon" @onclick="() => RemoveTorrent(e)" @onclick:stopPropagation="true" title="Remove">
                                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H5.5l1-1h3l1 1H14.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* ── Detail Panel ── *@
        @if (_selectedTorrent != null)
        {
            <div class="tc-detail-panel">
                <div class="tc-tabs">
                    <button class="tc-tab @(_detailTab == "general" ? "active" : "")" @onclick='() => _detailTab = "general"'>General</button>
                    <button class="tc-tab @(_detailTab == "files" ? "active" : "")" @onclick='() => _detailTab = "files"'>Files</button>
                    <button class="tc-tab @(_detailTab == "peers" ? "active" : "")" @onclick='() => _detailTab = "peers"'>Peers</button>
                    <button class="tc-tab @(_detailTab == "trackers" ? "active" : "")" @onclick='() => _detailTab = "trackers"'>Trackers</button>
                    <button class="tc-tab @(_detailTab == "log" ? "active" : "")" @onclick='() => _detailTab = "log"'>Log</button>
                </div>

                <div class="tc-tab-content">
                    @switch (_detailTab)
                    {
                        case "general":
                            <div class="tc-detail-grid">
                                <div class="tc-detail-item"><span class="tc-label">Name</span><span>@(_selectedTorrent.Swarm.Metadata?.Name ?? "—")</span></div>
                                <div class="tc-detail-item"><span class="tc-label">Info Hash</span><span class="tc-mono">@_selectedTorrent.InfoHashFull</span></div>
                                <div class="tc-detail-item"><span class="tc-label">Size</span><span>@(_selectedTorrent.Swarm.HasMetadata ? FormatBytes(_selectedTorrent.Swarm.Metadata!.TotalLength) : "—")</span></div>
                                <div class="tc-detail-item"><span class="tc-label">Pieces</span><span>@(_selectedTorrent.PieceManager != null ? $"{_selectedTorrent.PieceManager.CompletedCount} / {_selectedTorrent.PieceManager.PieceCount}" : "—")</span></div>
                                <div class="tc-detail-item"><span class="tc-label">Piece Length</span><span>@(_selectedTorrent.Swarm.HasMetadata ? FormatBytes(_selectedTorrent.Swarm.Metadata!.PieceLength) : "—")</span></div>
                                <div class="tc-detail-item"><span class="tc-label">Downloaded</span><span>@FormatBytes(_selectedTorrent.Swarm.Downloaded)</span></div>
                                <div class="tc-detail-item"><span class="tc-label">Uploaded</span><span>@FormatBytes(_selectedTorrent.Swarm.Uploaded)</span></div>
                                <div class="tc-detail-item"><span class="tc-label">Peers</span><span>@_selectedTorrent.Swarm.PeerCount</span></div>
                                <div class="tc-detail-item"><span class="tc-label">Status</span><span>@_selectedTorrent.TrackerStatus</span></div>
                            </div>

                            @* ── Piece Map ── *@
                            @if (_selectedTorrent.PieceManager?.Bitfield != null)
                            {
                                <div class="tc-piece-map-label">Pieces</div>
                                <div class="tc-piece-map">
                                    @{
                                        var bf = _selectedTorrent.PieceManager.Bitfield;
                                        var totalPieces = bf.Length;
                                        var cols = Math.Min(totalPieces, 100);
                                        var step = Math.Max(1, totalPieces / cols);
                                    }
                                    @for (int i = 0; i < cols; i++)
                                    {
                                        var startIdx = i * step;
                                        var endIdx = Math.Min((i + 1) * step, totalPieces);
                                        bool anyComplete = false;
                                        for (int j = startIdx; j < endIdx; j++)
                                            if (bf[j]) { anyComplete = true; break; }
                                        <div class="tc-piece @(anyComplete ? "tc-piece-done" : "")"></div>
                                    }
                                </div>
                            }
                            break;

                        case "files":
                            @if (_selectedTorrent.Swarm.HasMetadata)
                            {
                                <table class="tc-file-table">
                                    <thead><tr><th>File</th><th class="col-fsize">Size</th><th class="col-ftype">Type</th><th class="col-faction"></th></tr></thead>
                                    <tbody>
                                        @foreach (var file in _selectedTorrent.Swarm.Files)
                                        {
                                            var f = file;
                                            var ext = System.IO.Path.GetExtension(f.Path).ToLowerInvariant();
                                            var isMedia = IsMediaFile(ext);
                                            var isImage = IsImageFile(ext);
                                            <tr>
                                                <td class="tc-file-name">@f.Path</td>
                                                <td class="col-fsize">@FormatBytes(f.Length)</td>
                                                <td class="col-ftype"><span class="tc-ext-badge">@ext</span></td>
                                                <td class="col-faction">
                                                    @if (isMedia || isImage)
                                                    {
                                                        <button class="tc-btn-sm tc-btn-play" @onclick="() => OpenMedia(f, ext)" title="@(isImage ? "View" : "Play")">
                                                            @(isImage ? "View" : "Play")
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="tc-muted">Waiting for metadata...</p>
                            }
                            break;

                        case "peers":
                            <p class="tc-muted">@(_selectedTorrent.Swarm.PeerCount + (_selectedTorrent.PeerCoordinator?.PeerCount ?? 0)) connected peer(s)</p>
                            @if (_selectedTorrent.Swarm.PeerCount + (_selectedTorrent.PeerCoordinator?.PeerCount ?? 0) == 0)
                            {
                                <p class="tc-muted-sm">Peers connect via WebSocket tracker signaling and WebRTC data channels.</p>
                            }
                            break;

                        case "trackers":
                            <table class="tc-tracker-table">
                                <thead><tr><th>Tracker</th><th>Status</th></tr></thead>
                                <tbody>
                                    @foreach (var tracker in _selectedTorrent.Trackers)
                                    {
                                        <tr>
                                            <td class="tc-mono">@tracker.Url</td>
                                            <td>@tracker.Status</td>
                                        </tr>
                                    }
                                    @if (_selectedTorrent.Trackers.Count == 0)
                                    {
                                        <tr><td colspan="2" class="tc-muted">No trackers connected</td></tr>
                                    }
                                </tbody>
                            </table>
                            break;

                        case "log":
                            <div class="tc-log">
                                @foreach (var msg in _logMessages.TakeLast(100))
                                {
                                    <div class="tc-log-line">@msg</div>
                                }
                            </div>
                            break;
                    }
                </div>
            </div>
        }
    </div>

    @* ═══ Media Viewer Modal ═══ *@
    @if (_mediaOpen)
    {
        <div class="tc-modal-overlay" @onclick="CloseMedia">
            <div class="tc-modal" @onclick:stopPropagation="true">
                <div class="tc-modal-header">
                    <span class="tc-modal-title">@_mediaFileName</span>
                    <button class="tc-btn-icon tc-modal-close" @onclick="CloseMedia">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/></svg>
                    </button>
                </div>
                <div class="tc-modal-body">
                    @if (_mediaLoading)
                    {
                        <div class="tc-media-loading">Downloading file...</div>
                    }
                    else if (_mediaType == "video")
                    {
                        <video src="@_mediaBlobUrl" controls autoplay class="tc-media-video"></video>
                    }
                    else if (_mediaType == "audio")
                    {
                        <audio src="@_mediaBlobUrl" controls autoplay class="tc-media-audio"></audio>
                    }
                    else if (_mediaType == "image")
                    {
                        <img src="@_mediaBlobUrl" class="tc-media-image" alt="@_mediaFileName" />
                    }
                </div>
            </div>
        </div>
    }

    @* ═══ Settings Modal ═══ *@
    @if (_settingsOpen)
    {
        <div class="tc-modal-overlay" @onclick="() => _settingsOpen = false">
            <div class="tc-modal tc-settings-modal" @onclick:stopPropagation="true">
                <div class="tc-modal-header">
                    <span class="tc-modal-title">Settings</span>
                    <button class="tc-btn-icon tc-modal-close" @onclick="() => _settingsOpen = false">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/></svg>
                    </button>
                </div>
                <div class="tc-modal-body">
                    <div class="tc-settings-group">
                        <h4>Transfer</h4>
                        <div class="tc-setting-row">
                            <label>Download Limit (KB/s)</label>
                            <input type="number" class="tc-input tc-input-sm" value="@_downloadLimitKBs"
                                   @onchange="e => SetDownloadLimit(e)" placeholder="0 = unlimited" />
                        </div>
                        <div class="tc-setting-row">
                            <label>Upload Limit (KB/s)</label>
                            <input type="number" class="tc-input tc-input-sm" value="@_uploadLimitKBs"
                                   @onchange="e => SetUploadLimit(e)" placeholder="0 = unlimited" />
                        </div>
                        <div class="tc-setting-row">
                            <label>Max Connections per Torrent</label>
                            <input type="number" class="tc-input tc-input-sm" value="55" disabled />
                        </div>
                    </div>
                    <div class="tc-settings-group">
                        <h4>Trackers</h4>
                        <div class="tc-setting-info">Default trackers for new torrents:</div>
                        @foreach (var t in _defaultTrackers)
                        {
                            <div class="tc-tracker-item">@t</div>
                        }
                    </div>
                    <div class="tc-settings-group">
                        <h4>Client Info</h4>
                        <div class="tc-setting-row"><label>Peer ID</label><span class="tc-mono">@PeerIdString</span></div>
                        <div class="tc-setting-row"><label>Version</label><span>1.1.0</span></div>
                        <div class="tc-setting-row"><label>Platform</label><span>@(OperatingSystem.IsBrowser() ? "Browser (Blazor WASM)" : "Desktop (.NET)")</span></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _magnetInput = "";
    private readonly List<TorrentEntry> _torrents = new();
    private readonly List<string> _logMessages = new();
    private WebTorrentClient? _client;
    private IAsyncFS? _asyncFs;
    private System.Threading.Timer? _refreshTimer;
    private TorrentEntry? _selectedTorrent;
    private string _detailTab = "general";

    // Settings
    private bool _settingsOpen;
    private int _downloadLimitKBs;
    private int _uploadLimitKBs;
    private readonly string[] _defaultTrackers = new[]
    {
        "wss://hub.spawndev.com:44365/announce",
        "wss://tracker.openwebtorrent.com",
        "wss://tracker.files.fm:7073/announce",
        "wss://tracker.ghostchu-services.top:443/announce",
    };

    // Media viewer
    private bool _mediaOpen;
    private bool _mediaLoading;
    private string _mediaType = "";
    private string _mediaFileName = "";
    private string _mediaBlobUrl = "";

    // Global speeds
    private double _globalDownSpeed;
    private double _globalUpSpeed;

    private static readonly Dictionary<string, string> CCMagnets = new()
    {
        ["Big Buck Bunny"] = "magnet:?xt=urn:btih:dd8255ecdc7ca55fb0bbf81323d87062db1f6d1c&dn=Big+Buck+Bunny&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fbig-buck-bunny.torrent",
        ["Sintel"] = "magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10&dn=Sintel&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fsintel.torrent",
        ["Cosmos Laundromat"] = "magnet:?xt=urn:btih:c9e15763f722f23e98a29decdfae341b98d53056&dn=Cosmos+Laundromat&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fcosmos-laundromat.torrent",
        ["Tears of Steel"] = "magnet:?xt=urn:btih:209c8226b299b308beaf2b9cd3fb49212dbd13ec&dn=Tears+of+Steel&tr=wss%3A%2F%2Fhub.spawndev.com%3A44365%2Fannounce&tr=wss%3A%2F%2Ftracker.openwebtorrent.com&tr=wss%3A%2F%2Ftracker.files.fm%3A7073%2Fannounce&ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Ftears-of-steel.torrent",
    };

    private string PeerIdString => _client != null
        ? System.Text.Encoding.ASCII.GetString(_client.PeerId, 0, 8)
        : "-SD0110-";

    protected override void OnInitialized()
    {
        _client = new WebTorrentClient();

        // Create persistent file system (OPFS in browser)
        if (OperatingSystem.IsBrowser())
        {
            try
            {
                _asyncFs = new SpawnDev.AsyncFileSystem.BrowserWASM.AsyncFSFileSystemDirectoryHandle(JS);
            }
            catch { }
        }

        Log($"Client initialized (storage: {(_asyncFs != null ? "OPFS" : "memory")})");


        _refreshTimer = new System.Threading.Timer(_ =>
        {
            // Update speed calculations for all torrents
            foreach (var t in _torrents) t.Swarm.UpdateSpeed();
            _globalDownSpeed = _torrents.Sum(t => t.Swarm.DownloadSpeed);
            _globalUpSpeed = _torrents.Sum(t => t.Swarm.UploadSpeed);
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private async Task OnMagnetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_magnetInput))
            await AddMagnet();
    }

    private async Task QuickAdd(string name)
    {
        if (!CCMagnets.TryGetValue(name, out var magnet)) return;
        var hash = magnet.Split("btih:")[1].Split("&")[0].ToLowerInvariant();
        if (_torrents.Any(t => t.InfoHashFull == hash)) { Log($"{name} already added"); return; }
        await AddMagnetInternal(magnet, name);
    }

    private async Task AddMagnet()
    {
        var input = _magnetInput.Trim();
        _magnetInput = "";
        if (string.IsNullOrWhiteSpace(input)) return;
        await AddMagnetInternal(input, null);
    }

    private async Task AddMagnetInternal(string magnetUri, string? displayName)
    {
        if (_client == null) return;
        try
        {
            var swarm = await _client.AddAsync(magnetUri, new AddTorrentOptions { AsyncFileSystem = _asyncFs });
            var hash = Convert.ToHexString(swarm.InfoHash).ToLowerInvariant();

            var entry = new TorrentEntry
            {
                Swarm = swarm,
                Name = displayName,
                InfoHashFull = hash,
                InfoHashShort = hash[..8] + "...",
            };

            _torrents.Add(entry);
            _selectedTorrent ??= entry;
            Log($"Added: {entry.Name ?? hash[..8]}");

            _ = ConnectTrackers(entry, magnetUri);
            _ = FetchMetadataAndDownload(entry, magnetUri);
            StateHasChanged();
        }
        catch (Exception ex) { Log($"Error: {ex.Message}"); }
    }

    private async Task FetchMetadataAndDownload(TorrentEntry entry, string magnetUri)
    {
        string? torrentUrl = null;
        var webSeedUrls = new List<string>();
        foreach (var part in magnetUri.Split('&'))
        {
            var p = part.Contains('?') ? part.Split('?').Last() : part;
            var eq = p.IndexOf('=');
            if (eq < 0) continue;
            var k = p[..eq];
            var v = Uri.UnescapeDataString(p[(eq + 1)..].Replace('+', ' '));
            if (k == "xs") torrentUrl = v;
            if (k == "ws") webSeedUrls.Add(v);
        }

        if (torrentUrl == null) { Log($"[{entry.Name ?? entry.InfoHashShort}] No xs= URL"); return; }

        try
        {
            Log($"[{entry.Name ?? entry.InfoHashShort}] Fetching .torrent...");
            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(15) };
            var torrentBytes = await http.GetByteArrayAsync(torrentUrl);
            var metadata = TorrentParser.Parse(torrentBytes);
            if (!metadata.InfoHash.SequenceEqual(entry.Swarm.InfoHash)) return;

            foreach (var ws in metadata.UrlList)
                if (!webSeedUrls.Contains(ws)) webSeedUrls.Add(ws);

            entry.Swarm.SetMetadata(metadata);
            entry.Name ??= metadata.Name;

            foreach (var ws in webSeedUrls) entry.Swarm.AddWebSeed(ws);
            entry.Swarm.StartDownload();

            entry.Swarm.OnPieceVerified += (_) => InvokeAsync(StateHasChanged);
            entry.Swarm.OnDone += () => { Log($"[{entry.Name}] Download complete!"); InvokeAsync(StateHasChanged); };
            entry.Swarm.OnError += (ex) => { Log($"[{entry.Name}] Error: {ex.Message}"); };
            entry.Swarm.OnLog += (msg) => { Log($"[{entry.Name}] {msg}"); };

            Log($"[{entry.Name}] {FormatBytes(metadata.TotalLength)}, {metadata.PieceCount} pieces, {webSeedUrls.Count} web seed(s)");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Log($"[{entry.Name ?? entry.InfoHashShort}] {ex.Message}"); }
    }

    private async Task ConnectTrackers(TorrentEntry entry, string magnetUri)
    {
        var trackers = new List<string>();
        foreach (var part in magnetUri.Split('&'))
        {
            var p = part.Contains('?') ? part.Split('?').Last() : part;
            if (p.StartsWith("tr="))
            {
                var url = Uri.UnescapeDataString(p[3..].Replace('+', ' '));
                if (url.StartsWith("wss://")) trackers.Add(url);
            }
        }
        if (trackers.Count == 0) trackers.AddRange(_defaultTrackers);

        // Create WebRTC transport for browser P2P
        var webRtc = new WebRtcTransport();
        entry.WebRtcTransport = webRtc;

        // Create PeerCoordinator — handles full WebRTC signaling:
        // tracker discovers peers → create offer → relay via tracker →
        // receive answer → ICE connects → data channel opens → wire protocol
        var coordinator = new PeerCoordinator(_client!, entry.Swarm.InfoHash, webRtc);
        entry.PeerCoordinator = coordinator;

        coordinator.OnPeerConnected += (peer) =>
        {
            Log($"[{entry.Name ?? entry.InfoHashShort}] P2P connected: {peer.PeerId[..Math.Min(12, peer.PeerId.Length)]}");
            // Add the peer's wire protocol to the swarm
            _ = entry.Swarm.AddConnectedPeerAsync(peer.Wire, new Discovery.PeerInfo { Address = peer.PeerId, Source = "webrtc" });
            InvokeAsync(StateHasChanged);
        };
        coordinator.OnPeerDisconnected += (peer) =>
        {
            Log($"[{entry.Name ?? entry.InfoHashShort}] P2P disconnected: {peer.PeerId[..Math.Min(12, peer.PeerId.Length)]}");
            InvokeAsync(StateHasChanged);
        };
        coordinator.OnSwarmUpdate += (s, l) => InvokeAsync(StateHasChanged);

        // Connect to ALL trackers via PeerCoordinator
        foreach (var url in trackers)
        {
            _ = ConnectSingleTracker(entry, coordinator, url);
        }
    }

    private async Task ConnectSingleTracker(TorrentEntry entry, PeerCoordinator coordinator, string url)
    {
        var te = new TrackerEntry { Url = url, Status = "Connecting..." };
        entry.Trackers.Add(te);
        try
        {
            await coordinator.AddTrackerAsync(url);
            te.Status = "Connected";
            Log($"[{entry.Name ?? entry.InfoHashShort}] Tracker + signaling: {new Uri(url).Host}");
        }
        catch (Exception ex)
        {
            te.Status = "Failed";
            Log($"[{entry.Name ?? entry.InfoHashShort}] Tracker {new Uri(url).Host} failed: {ex.Message}");
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveTorrent(TorrentEntry entry)
    {
        if (_selectedTorrent == entry) _selectedTorrent = null;
        _torrents.Remove(entry);
        if (entry.PeerCoordinator != null) await entry.PeerCoordinator.DisposeAsync();
        if (entry.WebRtcTransport != null) await entry.WebRtcTransport.DisposeAsync();
        if (_client != null) await _client.RemoveAsync(entry.Swarm);
        Log($"Removed: {entry.Name ?? entry.InfoHashShort}");
    }

    private void SelectTorrent(TorrentEntry entry)
    {
        _selectedTorrent = entry;
        _detailTab = "general";
    }

    private void ToggleSettings() => _settingsOpen = !_settingsOpen;

    private void SetDownloadLimit(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            _downloadLimitKBs = val;
            if (_client != null) _client.DownloadLimit = val <= 0 ? -1 : val * 1024;
        }
    }

    private void SetUploadLimit(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            _uploadLimitKBs = val;
            if (_client != null) _client.UploadLimit = val <= 0 ? -1 : val * 1024;
        }
    }

    // ── Media Viewer ──

    private async Task OpenMedia(TorrentFileStream file, string ext)
    {
        _mediaFileName = file.Name;
        _mediaType = IsVideoFile(ext) ? "video" : IsAudioFile(ext) ? "audio" : IsImageFile(ext) ? "image" : "";
        _mediaOpen = true;
        _mediaLoading = true;
        _mediaBlobUrl = "";
        StateHasChanged();

        try
        {
            // Download the file via web seed
            var metadata = _selectedTorrent!.Swarm.Metadata!;
            var wsUrls = metadata.UrlList;
            byte[]? fileData = null;

            if (wsUrls.Length > 0)
            {
                using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(60) };
                var url = wsUrls[0].TrimEnd('/') + "/" + (metadata.Files.Length == 1 ? metadata.Files[0].Path : file.Path);
                var request = new HttpRequestMessage(HttpMethod.Get, url);
                request.Headers.Range = new System.Net.Http.Headers.RangeHeaderValue(file.Offset, file.Offset + file.Length - 1);
                var response = await http.SendAsync(request);
                fileData = await response.Content.ReadAsByteArrayAsync();
            }

            if (fileData == null || fileData.Length == 0)
            {
                _mediaLoading = false;
                Log($"Could not download {file.Name}");
                return;
            }

            // Create blob URL for playback
            var mimeType = GetMimeType(ext);
            using var blob = new Blob(new[] { fileData }, new BlobOptions { Type = mimeType });
            _mediaBlobUrl = URL.CreateObjectURL(blob);
            _mediaLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _mediaLoading = false;
            Log($"Media error: {ex.Message}");
        }
    }

    private void CloseMedia()
    {
        if (!string.IsNullOrEmpty(_mediaBlobUrl))
        {
            try { URL.RevokeObjectURL(_mediaBlobUrl); } catch { }
        }
        _mediaOpen = false;
        _mediaBlobUrl = "";
    }

    private static bool IsVideoFile(string ext) => ext is ".mp4" or ".webm" or ".mkv" or ".ogv" or ".mov" or ".m4v" or ".3gp";
    private static bool IsAudioFile(string ext) => ext is ".mp3" or ".ogg" or ".flac" or ".wav" or ".aac" or ".opus" or ".m4a";
    private static bool IsImageFile(string ext) => ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".svg" or ".bmp";
    private static bool IsMediaFile(string ext) => IsVideoFile(ext) || IsAudioFile(ext);

    private static string GetMimeType(string ext) => ext switch
    {
        ".mp4" or ".m4v" => "video/mp4",
        ".webm" => "video/webm",
        ".mkv" => "video/x-matroska",
        ".ogv" => "video/ogg",
        ".mov" => "video/quicktime",
        ".mp3" => "audio/mpeg",
        ".ogg" or ".opus" => "audio/ogg",
        ".flac" => "audio/flac",
        ".wav" => "audio/wav",
        ".aac" or ".m4a" => "audio/aac",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".png" => "image/png",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        ".svg" => "image/svg+xml",
        _ => "application/octet-stream",
    };

    // ── Helpers ──

    private void Log(string msg) { _logMessages.Add($"[{DateTime.Now:HH:mm:ss}] {msg}"); }
    private static string FormatBytes(long b) => b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024.0:F1} KB" : b < 1073741824 ? $"{b / 1048576.0:F1} MB" : $"{b / 1073741824.0:F2} GB";
    private static string FormatSpeed(double bps) => bps < 1024 ? $"{bps:F0} B/s" : bps < 1048576 ? $"{bps / 1024.0:F1} KB/s" : $"{bps / 1048576.0:F1} MB/s";

    public async ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        CloseMedia();
        if (_client != null) await _client.DisposeAsync();
    }

    private class TorrentEntry
    {
        public TorrentSwarm Swarm { get; init; } = null!;
        public string? Name { get; set; }
        public string InfoHashFull { get; init; } = "";
        public string InfoHashShort { get; init; } = "";
        public string? TrackerStatus { get; set; }
        public PieceManager? PieceManager => Swarm.PieceManager;
        public List<TrackerEntry> Trackers { get; } = new();
        public PeerCoordinator? PeerCoordinator { get; set; }
        public WebRtcTransport? WebRtcTransport { get; set; }
    }

    private class TrackerEntry
    {
        public string Url { get; set; } = "";
        public string Status { get; set; } = "";
    }
}

