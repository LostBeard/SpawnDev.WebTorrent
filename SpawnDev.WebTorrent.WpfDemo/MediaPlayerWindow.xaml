<Window x:Class="SpawnDev.WebTorrent.WpfDemo.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpawnDev.WebTorrent — Media Player"
        Width="800" Height="500"
        Background="#0f172a"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <MediaElement x:Name="Player" Grid.Row="0" LoadedBehavior="Manual"
                      UnloadedBehavior="Stop" Stretch="Uniform"
                      MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"/>

        <!-- Controls -->
        <Border Grid.Row="1" Background="#111827" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseBtn" Grid.Column="0" Content="Pause" Padding="10,4"
                        Background="#1e293b" Foreground="#f1f5f9" BorderThickness="0"
                        FontSize="12" Cursor="Hand" Click="PlayPause_Click"/>

                <Slider x:Name="SeekBar" Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" Value="0"
                        PreviewMouseLeftButtonUp="SeekBar_MouseUp"
                        IsSnapToTickEnabled="False"/>

                <TextBlock x:Name="TimeText" Grid.Column="2" Foreground="#94a3b8" FontSize="11"
                           FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="00:00 / 00:00"/>

                <TextBlock x:Name="FileNameText" Grid.Column="3" Foreground="#64748b" FontSize="11"
                           VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
