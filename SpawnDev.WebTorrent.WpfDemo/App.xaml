<Application x:Class="SpawnDev.WebTorrent.WpfDemo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Dark theme colors -->
            <SolidColorBrush x:Key="BgPrimary" Color="#0f172a"/>
            <SolidColorBrush x:Key="BgSecondary" Color="#1e293b"/>
            <SolidColorBrush x:Key="BgCard" Color="#1a2332"/>
            <SolidColorBrush x:Key="Border" Color="#334155"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#f1f5f9"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#94a3b8"/>
            <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>
            <SolidColorBrush x:Key="AccentGreen" Color="#10b981"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#3b82f6"/>
            <SolidColorBrush x:Key="AccentRed" Color="#ef4444"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
