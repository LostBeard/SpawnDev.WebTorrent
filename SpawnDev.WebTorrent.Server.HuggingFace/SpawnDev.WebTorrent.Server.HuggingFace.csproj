<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>4.2.2</Version>
		<PackageReleaseNotes>v4.2.2 - Dependency update</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Title>SpawnDev.WebTorrent.Server.HuggingFace</Title>
		<Authors>LostBeard</Authors>
		<Description>HuggingFace CDN proxy extension for SpawnDev.WebTorrent.Server. Fetches model files from HuggingFace's CDN on demand, caches locally, generates SHA-256 .torrent files, and serves as a BEP 17/19 web seed. Adds per-model request stats, LRU cache eviction, and configurable disk-headroom guards. Optional extension - SpawnDev.WebTorrent.Server works without it.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.WebTorrent</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageId>SpawnDev.WebTorrent.Server.HuggingFace</PackageId>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.WebTorrent.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>BitTorrent;WebTorrent;HuggingFace;P2P;ModelDelivery;MachineLearning;ASP.NET;WebSeed</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- bzip2 only. The BCL covers tar, gzip and zip; sherpa-onnx ships models as .tar.bz2, which is the
		     one container it cannot open. Central package management: no Version attribute here. -->
		<PackageReference Include="SharpZipLib" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.WebTorrent.Server\SpawnDev.WebTorrent.Server.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
	</ItemGroup>

</Project>
