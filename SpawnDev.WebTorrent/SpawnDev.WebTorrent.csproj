<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Deploy wwwroot contents to the app's root, not _content/SpawnDev.WebTorrent/ -->
		<!-- Required for service worker scope — SW must be at app root to intercept all requests -->
		<StaticWebAssetBasePath Condition="$(StaticWebAssetBasePath) == ''">/</StaticWebAssetBasePath>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Version>3.1.3-rc.13</Version>
		<PackageReleaseNotes>v3.1.3-rc.13: Pure-v2 torrents now work through the tracker + wire-handshake layer. Previously a `magnet:?xt=urn:btmh:...` (v2-only) magnet threw NotSupportedException, and `Torrent.StartDiscovery` bailed whenever v1 InfoHash was empty — pure-v2 swarms couldn't announce or find peers even though BEP 52 Phase 2c peer-wire support already shipped. rc.13 adds the cross-client wire-compat shim used by libtorrent / qBittorrent / rqbit: the 20-byte BitTorrent handshake value and tracker `info_hash` parameter are the FIRST 20 BYTES of the v2 SHA-256 hash for pure-v2 torrents (v1 hash still used verbatim when present). New `Torrent.WireInfoHashHex` accessor centralizes the fallback. `Peer.SendHandshake`, `Torrent.StartDiscovery`, and `WebTorrentClient.Get(hash)` all route through it. Also `WebTorrentClient.Get(hash)` now matches against v1 InfoHash, full V2InfoHash, AND the 20-byte wire truncation so callers can look up pure-v2 torrents by any of the three forms. plus TorrentCreator.CreateFromMultipleStreamsAsync — streaming v2 multi-file creator with per-file IncrementalMerkleHasher for seeding multi-GB HuggingFace model shards without RAM buffering. v3.1.3-rc.12: Duplicate-peer tiebreaker on WebRTC channel Label (the cross-side-stable axis). v3.1.3-rc.11: RtcPeer deferred EmitConnect when channel already open. v3.1.3-rc.4: RtcPeer.PeerConnection public getter. v3.1.3-rc.3: SpawnDev.RTC 1.1.3-rc.2 dep bump (SCTP burst tunables). v3.1.3-rc.2: Pure-v2 multi-file past file 0, single-_push Wire frames, hardened DisposeAsync. v3.1.3-rc.1: SpawnDev.RTC 1.1.3-rc.1 dep bump.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Title>SpawnDev.WebTorrent</Title>
		<Authors>LostBeard</Authors>
		<Description>Pure C# BitTorrent/WebTorrent client. 15 BEPs, real WebRTC P2P (browser + desktop), DHT with mutable items (BEP 46 — AI agent communication), web seeds, media streaming with seeking via service worker, OPFS storage. Includes webtorrent-sw.js for COI headers + torrent streaming. No JavaScript dependencies. Runs on desktop (.NET + SIPSorcery) and browser (Blazor WASM + SpawnDev.BlazorJS). 444 unit tests.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.WebTorrent</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.WebTorrent.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>BitTorrent;WebTorrent;P2P;Torrent;Blazor;WebAssembly;WebRTC;DHT;Streaming;MachineLearning;ModelDelivery;SIPSorcery</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SpawnDev.WebTorrent.Tests" />
		<InternalsVisibleTo Include="SpawnDev.WebTorrent.Demo.Shared" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.BlazorJS" Version="3.5.3" />
		<PackageReference Include="SpawnDev.AsyncFileSystem" Version="1.2.0" />
		<PackageReference Include="SpawnDev.BlazorJS.Cryptography" Version="3.2.0" />
		<!-- SpawnDev.RTC replaces direct SipSorcery dependency - provides cross-platform WebRTC
		     with proven browser-interop SipSorcery fork (SRTP profile fix) bundled inside.
		     PackageReference (not ProjectReference) so CI / GitHub Pages builds work from a
		     standalone SpawnDev.WebTorrent checkout - they don't have the sibling RTC repo.
		     1.1.1 is the minimum version: 1.1.0 declared a dep on public SIPSorcery 10.0.4-pre
		     which doesn't exist on nuget.org; 1.1.1 bundles the fork DLLs inline (ILGPU pattern). -->
		<PackageReference Include="SpawnDev.RTC" Version="1.1.3-rc.3" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

</Project>
