{
  // ═══════════════════════════════════════════════════════════════
  //  SpawnDev.WebTorrent.ServerApp — Configuration
  //
  //  Copy this file to appsettings.json and customize for your
  //  deployment. All values shown are defaults — only include
  //  settings you want to change.
  //
  //  Environment-specific overrides: appsettings.Production.json
  //  Environment variables: use __ as separator
  //    e.g., HuggingFace__MaxCacheSizeBytes=10737418240
  // ═══════════════════════════════════════════════════════════════

  // ─── WebSocket Tracker ─────────────────────────────────────────
  "Tracker": {
    // Seconds between client announce requests (lower = more responsive, more traffic)
    "AnnounceInterval": 120,

    // Maximum peers returned per announce response
    "MaxPeersPerAnnounce": 50
  },

  // ─── Web Seed Server ───────────────────────────────────────────
  "WebSeed": {
    // Directory for manually seeded torrent data
    // Relative to working directory, or absolute path
    "Directory": "seed-data"
  },

  // ─── HuggingFace Model Proxy & Cache ───────────────────────────
  "HuggingFace": {
    // Cache directories for downloaded model files.
    // Models are stored in the directory with the most free space.
    // Multiple paths allow spreading across drives.
    //
    // Examples:
    //   Linux:   ["/var/cache/spawndev-hub/hf", "/mnt/data/hf-cache"]
    //   Windows: ["D:\\cache\\hf", "E:\\cache\\hf"]
    //   Default: ["hf-cache"] (relative to working directory)
    "CacheDirectories": [ "hf-cache" ],

    // Tracker URLs included in generated .torrent files.
    // Clients use these to discover peers for P2P model sharing.
    // Replace with your own tracker URL if self-hosting.
    "TrackerUrls": [ "wss://hub.spawndev.com:44365/announce" ],

    // Maximum total cache size in bytes across all directories.
    // When exceeded, least-recently-requested models are evicted.
    // 0 = no explicit limit (drive free space protection still applies).
    //
    // Examples:
    //   10 GB:  10737418240
    //   50 GB:  53687091200
    //   100 GB: 107374182400
    "MaxCacheSizeBytes": 0,

    // Minimum free disk space to maintain on each cache drive (bytes).
    // Server evicts cached models before the drive drops below this.
    // This is a safety net — even without MaxCacheSizeBytes, the
    // server will never fill your drive.
    //
    // Default: 2 GB (2147483648)
    // For small VMs, consider 1 GB: 1073741824
    "MinFreeDiskSpaceBytes": 2147483648
  },

  // Generic allowlisted source proxy:  GET /src?url=<https url>
  //
  // The hub had a hand-written proxy per source (HuggingFace, Ollama), so every new origin meant new
  // code. This is the generic form - same caching and range support, pointed at any host on this list -
  // which turns a CORS-less or awkwardly-packaged origin into a plain URL a browser can range-read.
  // GET /src/allowed reports the live list.
  "SourceProxy": {

    // Hosts this server will fetch from. An entry also permits its SUBDOMAINS.
    //
    // EMPTY (the default when this section is absent) means the proxy refuses everything. That is
    // deliberate: an open proxy lets anyone launder requests through this host and spend its bandwidth,
    // and "we will lock it down later" is how it stays open. Add hosts by name, on purpose.
    //
    // Large downloads REDIRECT to a different host, so a single source often needs several entries -
    // GitHub releases land on objects.githubusercontent.com, HuggingFace on cdn-lfs domains. Each one
    // is a deliberate decision rather than a wildcard.
    //
    // Literal IP addresses are refused regardless of this list (the classic SSRF shape), as is plain http.
    "AllowedHosts": [
      "github.com",
      "objects.githubusercontent.com",
      "huggingface.co",
      "cdn-lfs.huggingface.co",
      "cdn-lfs-us-1.hf.co"
    ],

    // Where proxied files are cached. Same partial-file cache the model proxies use, so range requests
    // are served from disk once fetched.
    "CacheDirectory": "src-cache",

    // Bound the cache. Without a bound it grows until the drive is full, and then the proxy does not
    // degrade, it FAILS - and it takes the tracker and web seed sharing that disk down with it.
    // Re-fetching an evicted file is cheap; running a host out of disk is not.
    //
    // Eviction is least-recently-used and is checked BEFORE a fetch, not after: checking afterwards means
    // the download that fills the drive is the one that succeeds in filling it.
    //
    // 0 = no explicit size limit (the free-space floor below still applies).
    "MaxCacheSizeBytes": 107374182400,

    // Free space to keep available on the cache drive. Higher than the HuggingFace proxy's 2 GB because
    // the units differ: that proxy caches individual FILES, this one caches whole ARCHIVES that arrive in
    // one piece - the fp32 ZipVoice package alone is 634 MB. The floor must exceed the largest single
    // thing that can arrive, or the guard trips only after the fetch it exists to prevent.
    "MinFreeDiskSpaceBytes": 21474836480
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
