<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="assets\testcert.pfx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Playwright.NUnit" />
		<PackageReference Include="Mono.Cecil" />
		<PackageReference Include="NUnit" />
		<PackageReference Include="NUnit.Analyzers" />
		<PackageReference Include="NUnit3TestAdapter" />
		<PackageReference Include="Microsoft.CodeAnalysis" PrivateAssets="All" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="SpawnDev.UnitTesting" />
		<PackageReference Include="SpawnDev.BlazorJS.Cryptography" />
		<!-- SpawnDev.RTC.Server needed by tests that spin up an in-process local
		     tracker (desktop-only; test-infra, never shipped). -->
		<PackageReference Include="SpawnDev.RTC.Server" />
		<ProjectReference Include="..\SpawnDev.WebTorrent\SpawnDev.WebTorrent.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.Playwright.NUnit" />
		<Using Include="NUnit.Framework" />
		<Using Include="System.Text.RegularExpressions" />
		<Using Include="System.Threading.Tasks" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="TestResults\" />
		<Folder Include="WGSLDumps\" />
	</ItemGroup>

</Project>
