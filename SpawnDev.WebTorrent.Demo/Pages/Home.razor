@page "/"

<PageTitle>SpawnDev.WebTorrent — Decentralized Model Delivery</PageTitle>

<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">
            <span class="gradient-text">SpawnDev.WebTorrent</span>
        </h1>
        <p class="hero-subtitle">Pure C# BitTorrent. Desktop + Browser. Zero JavaScript. 15 BEPs. AI Agent Communication.</p>
        <p class="hero-description">
            A complete BitTorrent/WebTorrent implementation in C# — client, server, tracker, DHT, and AI agent pub/sub.
            15 BEPs, real WebRTC P2P, DHT mutable items for shared AI state, media streaming with seeking.
            Runs on .NET desktop (WPF + SIPSorcery) and Blazor WebAssembly (SpawnDev.BlazorJS).
            Built for decentralized AI model delivery and distributed compute: every device becomes a peer.
        </p>
        <div class="hero-buttons">
            <a href="torrents" class="btn btn-primary btn-lg">
                <span class="btn-icon">&#x1F517;</span> Try Torrent Client
            </a>
            <a href="tests" class="btn btn-secondary btn-lg">
                <span class="btn-icon">&#x1F9EA;</span> Run Tests
            </a>
            <a href="https://github.com/LostBeard/SpawnDev.WebTorrent" target="_blank" class="btn btn-secondary btn-lg">
                <span class="btn-icon">&#x1F4E6;</span> GitHub
            </a>
            <a href="https://hub.spawndev.com:44365/" target="_blank" class="btn btn-secondary btn-lg">
                <span class="btn-icon">&#x1F310;</span> Live Server
            </a>
        </div>

        <div class="stats-banner">
            <div class="stat-item"><span class="stat-num">15</span><span class="stat-desc">BEPs</span></div>
            <div class="stat-item"><span class="stat-num">24</span><span class="stat-desc">Core Files</span></div>
