    private List<Torrent> FilteredTorrents => _activeFilter switch
    {
        "downloading" => Client.Torrents.Where(t => !t.Done && !t.Paused && !t.Destroyed).ToList(),
        "seeding" => Client.Torrents.Where(t => t.Done && !t.Paused).ToList(),
